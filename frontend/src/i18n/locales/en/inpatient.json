    "carePlans": {
      "library": {
        "FALLS": {
          "problem": "Risk of falls",
          "goal": "No fall during the stay",
          "interventions": {
            "0": "Bed at the lowest height, brakes on",
            "1": "Call bell and belongings within reach",
            "2": "Non-slip footwear; help to the toilet",
            "3": "Yellow fall-risk band on",
            "4": "Reassess the fall score daily"
          }
        },
        "PRESSURE": {
          "problem": "Risk of pressure injury",
          "goal": "Skin stays intact",
          "interventions": {
            "0": "Turn every 2 hours; record on the turning chart",
            "1": "Pressure-relieving mattress",
            "2": "Keep skin clean and dry; barrier cream",
            "3": "Check heels, sacrum and elbows each shift",
            "4": "Ask the dietician to review"
          }
        },
        "PAIN": {
          "problem": "Acute pain",
          "goal": "Pain score 3 or less within 24 hours",
          "interventions": {
            "0": "Give pain relief as charted",
            "1": "Recheck the pain score 30–60 minutes after a dose",
            "2": "Comfortable position; splint or pillow support",
            "3": "Tell the doctor if the score stays 7 or more"
          }
        },
        "NUTRITION": {
          "problem": "Risk of malnutrition",
          "goal": "Eats at least half of each meal; weight stable",
          "interventions": {
            "0": "Dietician referral",
            "1": "Food and fluid chart",
            "2": "Weigh twice a week",
            "3": "Help with meals; supplements as advised"
          }
        },
        "CONSCIOUSNESS": {
          "problem": "Reduced consciousness",
          "goal": "Airway safe; any change in GCS caught early",
          "interventions": {
            "0": "Neuro observations every hour",
            "1": "Head end up 30°; recovery position when needed",
            "2": "Suction at the bedside",
            "3": "Turn every 2 hours"
          }
        },
        "LINES": {
          "problem": "Risk of infection from lines and catheters",
          "goal": "No line or catheter infection",
          "interventions": {
            "0": "Hand hygiene before touching any line",
            "1": "Check the site every shift",
            "2": "Change the dressing when soiled or loose",
            "3": "Remove lines and catheters as soon as they are not needed"
          }
        },
        "AIRWAY": {
          "problem": "Ineffective airway clearance",
          "goal": "SpO₂ 94% or more; clear chest",
          "interventions": {
            "0": "Head end up 30–45°",
            "1": "Nebulisation as charted",
            "2": "Deep breathing and coughing; chest physiotherapy",
            "3": "Suction when needed"
          }
        },
        "GLUCOSE": {
          "problem": "Unstable blood sugar",
          "goal": "Blood sugar 140–180 mg/dL; no low sugar",
          "interventions": {
            "0": "Sugar check before meals and at bedtime",
            "1": "Insulin as charted",
            "2": "Watch for sweating, confusion (low sugar); give glucose",
            "3": "Diabetic diet"
          }
        }
      },
