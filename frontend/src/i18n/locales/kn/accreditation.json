          "2_2_1": "ಕಲಿಕಾ ಮಟ್ಟದ ಮೌಲ್ಯಮಾಪನ; ಮುಂದುವರಿದ ಮತ್ತು ನಿಧಾನ ಕಲಿಕಾರ್ಥಿಗಳಿಗೆ ಕಾರ್ಯಕ್ರಮಗಳು",
          "2_2_2": "ವಿದ್ಯಾರ್ಥಿ – ಪೂರ್ಣಾವಧಿ ಶಿಕ್ಷಕರ ಅನುಪಾತ",
          "2_3_1": "ವಿದ್ಯಾರ್ಥಿ ಕೇಂದ್ರಿತ ವಿಧಾನಗಳು: ಅನುಭವಾತ್ಮಕ, ಸಹಭಾಗಿತ್ವದ, ಸಮಸ್ಯೆ ಪರಿಹಾರದ",
          "2_3_2": "ICT ಆಧಾರಿತ ಸಾಧನಗಳನ್ನು ಬಳಸುವ ಶಿಕ್ಷಕರು",
          "2_3_3": "ವಿದ್ಯಾರ್ಥಿ – ಮಾರ್ಗದರ್ಶಕರ ಅನುಪಾತ",
          "2_4_1": "ಮಂಜೂರಾದ ಹುದ್ದೆಗಳಿಗೆ ಎದುರಾಗಿ ಪೂರ್ಣಾವಧಿ ಶಿಕ್ಷಕರು",
          "2_4_2": "ಪಿಎಚ್.ಡಿ. ಹೊಂದಿರುವ ಪೂರ್ಣಾವಧಿ ಶಿಕ್ಷಕರು",
          "2_4_3": "ಪೂರ್ಣಾವಧಿ ಶಿಕ್ಷಕರ ಸರಾಸರಿ ಬೋಧನಾ ಅನುಭವ",
          "2_5_1": "ಕೊನೆಯ ಸೆಮಿಸ್ಟರ್ ಅಂತ್ಯದ ಪರೀಕ್ಷೆಯಿಂದ ಫಲಿತಾಂಶ ಪ್ರಕಟಣೆಯವರೆಗಿನ ದಿನಗಳು",
          "2_5_2": "ಮೌಲ್ಯಮಾಪನದ ಕುರಿತು ವಿದ್ಯಾರ್ಥಿಗಳ ದೂರುಗಳು / ಕುಂದುಕೊರತೆಗಳು",
          "2_6_1": "ಕಾರ್ಯಕ್ರಮ ಮತ್ತು ಕೋರ್ಸ್ ಫಲಿತಗಳನ್ನು ನಿಗದಿಪಡಿಸಿ ತಿಳಿಸಲಾಗಿದೆ",
          "2_6_2": "ಕಾರ್ಯಕ್ರಮ ಮತ್ತು ಕೋರ್ಸ್ ಫಲಿತಗಳ ಸಾಧನೆ",
          "2_6_3": "ಅಂತಿಮ ವರ್ಷದ ವಿದ್ಯಾರ್ಥಿಗಳ ಉತ್ತೀರ್ಣ ಶೇಕಡಾವಾರು",
          "2_7_1": "ಆನ್‌ಲೈನ್ ವಿದ್ಯಾರ್ಥಿ ತೃಪ್ತಿ ಸಮೀಕ್ಷೆ (SSS)",
          "3_1_1": "ಸಂಶೋಧನಾ ಯೋಜನೆಗಳಿಗೆ ಪಡೆದ ಅನುದಾನ (₹ ಲಕ್ಷ)",
          "3_1_2": "ಸಂಶೋಧನಾ ಮಾರ್ಗದರ್ಶಕರೆಂದು ಮಾನ್ಯತೆ ಪಡೆದ ಶಿಕ್ಷಕರು",
          "3_1_3": "ಅನುದಾನಿತ ಸಂಶೋಧನಾ ಯೋಜನೆಗಳಿರುವ ಇಲಾಖೆಗಳು",
          "3_2_1": "ನಾವೀನ್ಯತೆ, ಇನ್‌ಕ್ಯುಬೇಷನ್ ಮತ್ತು ಜ್ಞಾನ ವರ್ಗಾವಣೆಗೆ ಪೂರಕ ವ್ಯವಸ್ಥೆ",
          "3_2_2": "ಸಂಶೋಧನಾ ವಿಧಾನ, ಬೌದ್ಧಿಕ ಆಸ್ತಿ ಹಕ್ಕು (IPR) ಮತ್ತು ಉದ್ಯಮಶೀಲತೆ ಕುರಿತು ಕಾರ್ಯಾಗಾರಗಳು / ವಿಚಾರಸಂಕಿರಣಗಳು",
          "3_3_1": "ಅರ್ಹ ಶಿಕ್ಷಕರೊಬ್ಬರಿಗೆ ನೋಂದಾಯಿತ ಪಿಎಚ್.ಡಿ.ಗಳು",
          "3_3_2": "UGC-CARE ನಿಯತಕಾಲಿಕಗಳಲ್ಲಿ ಪ್ರತಿ ಶಿಕ್ಷಕರ ಸಂಶೋಧನಾ ಲೇಖನಗಳು",
          "3_3_3": "ಪ್ರತಿ ಶಿಕ್ಷಕರ ಪುಸ್ತಕಗಳು, ಅಧ್ಯಾಯಗಳು ಮತ್ತು ಸಮ್ಮೇಳನ ಲೇಖನಗಳು",
          "3_4_1": "ನೆರೆಹೊರೆಯ ಸಮುದಾಯದಲ್ಲಿ ವಿಸ್ತರಣಾ ಚಟುವಟಿಕೆಗಳು",
          "3_4_2": "ವಿಸ್ತರಣಾ ಚಟುವಟಿಕೆಗಳಿಗೆ ಪ್ರಶಸ್ತಿಗಳು ಮತ್ತು ಮನ್ನಣೆ",
          "3_4_3": "ನಡೆಸಿದ ವಿಸ್ತರಣಾ ಮತ್ತು ಸಮುದಾಯ ಸಂಪರ್ಕ ಕಾರ್ಯಕ್ರಮಗಳು",
          "3_4_4": "ವಿಸ್ತರಣಾ ಚಟುವಟಿಕೆಗಳಲ್ಲಿ ಭಾಗವಹಿಸುವ ವಿದ್ಯಾರ್ಥಿಗಳು",
          "3_5_1": "ಸಹಯೋಗ ಚಟುವಟಿಕೆಗಳು (ಸಂಶೋಧನೆ, ಇಂಟರ್ನ್‌ಶಿಪ್, ವಿನಿಮಯ)",
          "3_5_2": "ಸಂಸ್ಥೆಗಳು ಮತ್ತು ಉದ್ಯಮಗಳೊಂದಿಗೆ ಜಾರಿಯಲ್ಲಿರುವ ಒಡಂಬಡಿಕೆಗಳು (MoU)",
          "4_1_1": "ಬೋಧನೆ–ಕಲಿಕೆಗೆ ಸಾಕಷ್ಟು ಸೌಲಭ್ಯಗಳು",
          "4_1_2": "ಸಾಂಸ್ಕೃತಿಕ ಚಟುವಟಿಕೆಗಳು, ಕ್ರೀಡೆ ಮತ್ತು ಆಟಗಳಿಗೆ ಸೌಲಭ್ಯಗಳು",
          "4_1_3": "ICT ಸೌಲಭ್ಯವಿರುವ ತರಗತಿ ಕೊಠಡಿಗಳು ಮತ್ತು ವಿಚಾರಸಂಕಿರಣ ಸಭಾಂಗಣಗಳು",
          "4_1_4": "ಮೂಲಸೌಕರ್ಯ ವೃದ್ಧಿಗೆ ವೆಚ್ಚ, ವೇತನ ಹೊರತುಪಡಿಸಿ (₹ ಲಕ್ಷ)",
          "4_2_1": "ಸಮಗ್ರ ಗ್ರಂಥಾಲಯ ನಿರ್ವಹಣಾ ವ್ಯವಸ್ಥೆಯೊಂದಿಗೆ ಸ್ವಯಂಚಾಲಿತ ಗ್ರಂಥಾಲಯ",
          "4_2_2": "ಗ್ರಂಥಾಲಯದಲ್ಲಿ ಚಂದಾದಾರಿಕೆಯ ಇ-ಸಂಪನ್ಮೂಲಗಳು / ಇ-ಪುಸ್ತಕಗಳು",
          "4_2_3": "ಪುಸ್ತಕಗಳು ಮತ್ತು ನಿಯತಕಾಲಿಕಗಳಿಗೆ ವೆಚ್ಚ (₹ ಲಕ್ಷ)",
          "4_2_4": "ದಿನವೊಂದಕ್ಕೆ ಗ್ರಂಥಾಲಯ ಬಳಕೆ (ಎರವಲು)",
          "4_3_1": "ನಿಯಮಿತವಾಗಿ ಉನ್ನತೀಕರಿಸುವ IT ಸೌಲಭ್ಯಗಳು ಮತ್ತು Wi-Fi",
          "4_3_2": "ವಿದ್ಯಾರ್ಥಿ – ಕಂಪ್ಯೂಟರ್ ಅನುಪಾತ",
          "4_3_3": "ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕದ ಬ್ಯಾಂಡ್‌ವಿಡ್ತ್ (Mbps)",
          "4_4_1": "ಮೂಲಸೌಕರ್ಯ ನಿರ್ವಹಣೆಗೆ ವೆಚ್ಚ (₹ ಲಕ್ಷ)",
          "5_1_1": "ಸರ್ಕಾರಿ ವಿದ್ಯಾರ್ಥಿವೇತನ ಮತ್ತು ಶುಲ್ಕ ವಿನಾಯಿತಿಯ ಪ್ರಯೋಜನ ಪಡೆದ ವಿದ್ಯಾರ್ಥಿಗಳು",
          "5_1_2": "ಸಂಸ್ಥೆಯ / ಸರ್ಕಾರೇತರ ವಿದ್ಯಾರ್ಥಿವೇತನದ ಪ್ರಯೋಜನ ಪಡೆದ ವಿದ್ಯಾರ್ಥಿಗಳು",
          "5_1_3": "ಸಾಮರ್ಥ್ಯ ವೃದ್ಧಿ ಮತ್ತು ಕೌಶಲ ಅಭಿವೃದ್ಧಿ ಉಪಕ್ರಮಗಳು",
          "5_1_4": "ಸ್ಪರ್ಧಾತ್ಮಕ ಪರೀಕ್ಷೆಗಳ ಮಾರ್ಗದರ್ಶನ ಮತ್ತು ವೃತ್ತಿ ಸಮಾಲೋಚನೆಯ ಪ್ರಯೋಜನ ಪಡೆದ ವಿದ್ಯಾರ್ಥಿಗಳು",
          "5_1_5": "ಕುಂದುಕೊರತೆ ನಿವಾರಣಾ ವ್ಯವಸ್ಥೆ (ಲೈಂಗಿಕ ಕಿರುಕುಳ, ರ‍್ಯಾಗಿಂಗ್)",
          "5_2_1": "ವ್ಯಾಸಂಗ ಮುಗಿಸಿದ ವಿದ್ಯಾರ್ಥಿಗಳ ಉದ್ಯೋಗ ನೇಮಕಾತಿ",
          "5_2_2": "ಉನ್ನತ ಶಿಕ್ಷಣಕ್ಕೆ ಮುಂದುವರಿದ ವಿದ್ಯಾರ್ಥಿಗಳು",
          "5_2_3": "ರಾಜ್ಯ / ರಾಷ್ಟ್ರ ಮಟ್ಟದ ಪರೀಕ್ಷೆಗಳಲ್ಲಿ ಅರ್ಹತೆ ಪಡೆದ ವಿದ್ಯಾರ್ಥಿಗಳು (NET, SLET, GATE, CAT …)",
          "5_3_1": "ಕ್ರೀಡೆ ಮತ್ತು ಸಾಂಸ್ಕೃತಿಕ ಚಟುವಟಿಕೆಗಳಲ್ಲಿ ಪ್ರಶಸ್ತಿಗಳು / ಪದಕಗಳು",
          "5_3_2": "ಸಕ್ರಿಯ ವಿದ್ಯಾರ್ಥಿ ಪರಿಷತ್ತು ಮತ್ತು ವಿದ್ಯಾರ್ಥಿ ಪ್ರಾತಿನಿಧ್ಯ",
          "5_3_3": "ಆಯೋಜಿಸಿದ ಕ್ರೀಡಾ ಮತ್ತು ಸಾಂಸ್ಕೃತಿಕ ಕಾರ್ಯಕ್ರಮಗಳು",
          "5_4_1": "ನೋಂದಾಯಿತ ಹಳೆಯ ವಿದ್ಯಾರ್ಥಿಗಳ ಸಂಘ ಮತ್ತು ಅದರ ಕೊಡುಗೆ",
          "6_1_1": "ಧ್ಯೇಯ ಮತ್ತು ಉದ್ದೇಶಗಳನ್ನು ಪ್ರತಿಬಿಂಬಿಸುವ ಆಡಳಿತ",
          "6_2_1": "ದೀರ್ಘಾವಧಿ / ಕಾರ್ಯತಂತ್ರ ಯೋಜನೆಯ ಅನುಷ್ಠಾನ; ಸಾಂಸ್ಥಿಕ ಮಂಡಳಿಗಳ ಕಾರ್ಯನಿರ್ವಹಣೆ",
          "6_2_2": "ಆಡಳಿತ, ಹಣಕಾಸು, ಪ್ರವೇಶ ಮತ್ತು ಪರೀಕ್ಷೆಗಳಲ್ಲಿ ಇ-ಆಡಳಿತ",
          "6_3_1": "ಬೋಧಕ ಮತ್ತು ಬೋಧಕೇತರ ಸಿಬ್ಬಂದಿಗೆ ಕಲ್ಯಾಣ ಕ್ರಮಗಳು",
