          "1_2_1": "CBCS / ಐಚ್ಛಿಕ ಕೋರ್ಸ್ ವ್ಯವಸ್ಥೆ ಇರುವ ಕಾರ್ಯಕ್ರಮಗಳು",
          "1_2_2": "ನೀಡಲಾಗುವ ಹೆಚ್ಚುವರಿ / ಪ್ರಮಾಣಪತ್ರ ಕಾರ್ಯಕ್ರಮಗಳು",
          "1_2_3": "ಹೆಚ್ಚುವರಿ / ಪ್ರಮಾಣಪತ್ರ ಕಾರ್ಯಕ್ರಮಗಳಿಗೆ ದಾಖಲಾದ ವಿದ್ಯಾರ್ಥಿಗಳು",
          "1_3_1": "ಸಮಗ್ರ ವಿಷಯಗಳು: ಲಿಂಗ ಸಮಾನತೆ, ಪರಿಸರ, ಮಾನವೀಯ ಮೌಲ್ಯಗಳು, ವೃತ್ತಿಪರ ನೈತಿಕತೆ",
          "1_3_2": "ಅನುಭವಾತ್ಮಕ ಕಲಿಕೆ ಇರುವ ಕೋರ್ಸ್‌ಗಳು (ಯೋಜನಾ ಕಾರ್ಯ, ಕ್ಷೇತ್ರ ಕಾರ್ಯ, ಇಂಟರ್ನ್‌ಶಿಪ್)",
