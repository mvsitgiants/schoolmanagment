{{!-- Grade card (A4), UGC CBCS format, for one student's semester in an exam session.
      student.name, registerNo, admissionNo, dob, batch, semester · program.name, code, department, regulation ·
      session.month / session.name, session.supplementary, session.published, session.publishedAt ·
      courses[] {code, title, credits, grade, points, creditPoints, result (P / RA), revalued, internal, external, total, max}
      · totals.credits, totals.creditPoints · result.sgpa, cgpa, creditsRegistered, creditsEarned, cumulativeCredits,
      arrears, pass · scale[] {grade, label, range, points}. University formats are made from this in
      Administration › Print templates. --}}
<style>
  table.grid { font-size: 9pt } table.grid th { text-align: center; vertical-align: middle } table.grid th.l { text-align: left }
  table.grid td.c { text-align: center; white-space: nowrap } table.grid td.sn { text-align: center; width: 9mm }
  .who { margin-bottom: 3mm } .who td.k { padding-right: 3mm }
  .ra { font-weight: 700; text-decoration: underline }
  .sum { margin-top: 4mm } .sum td { text-align: center; font-weight: 700; font-size: 10pt } .sum th { font-size: 8.2pt }
  .scale { margin-top: 4mm } .scale .cap { font-size: 7.8pt; font-weight: 600; margin-bottom: .8mm }
  .scale table.grid { font-size: 7.4pt; table-layout: fixed } .scale table.grid th:first-child { width: 24mm } .scale table.grid th, .scale table.grid td { padding: .6mm .8mm; text-align: center }
  .signs { margin-top: 26mm } .signs .sealed { position: relative } .signs .sealed .seal { position: absolute; left: 50%; bottom: 100%; transform: translate(-50%, -1.5mm); margin: 0 }
  .place { margin-top: 6mm; font-size: 9pt; line-height: 1.7 }
  .draft { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 50pt; font-weight: 800; color: rgba(0,0,0,.07); transform: rotate(-20deg); pointer-events: none }
</style>
{{#unless session.published}}<div class="draft">{{t "coe.print.gradeCard.provisional" "PROVISIONAL"}}</div>{{/unless}}
{{#> letterhead}}{{/letterhead}}
<div class="doc-title">{{t "coe.print.gradeCard.title" "Grade card"}}</div>
<div class="doc-sub">{{t "coe.print.gradeCard.examOf" "End-semester examinations, {{month}}" month=(default session.month session.name)}}{{#if session.supplementary}} · {{t "coe.print.gradeCard.supplementary" "Supplementary examination"}}{{/if}}</div>

<table class="kv who">
  <tr><td class="k">{{t "coe.print.gradeCard.name" "Name of the student"}}</td><td class="v" colspan="3">{{upper student.name}}</td></tr>
  <tr><td class="k">{{t "coe.print.gradeCard.registerNo" "Register No."}}</td><td class="v mono">{{default student.registerNo student.admissionNo}}</td>
      <td class="k">{{t "coe.print.gradeCard.semester" "Semester"}}</td><td class="v">{{student.semester}}</td></tr>
  <tr><td class="k">{{t "coe.print.gradeCard.program" "Programme"}}</td><td class="v">{{program.name}}{{#if program.code}} ({{program.code}}){{/if}}</td>
      <td class="k">{{t "coe.print.gradeCard.batch" "Batch"}}</td><td class="v">{{student.batch}}</td></tr>
  {{#if (or program.department student.dob)}}
  <tr><td class="k">{{t "coe.print.gradeCard.department" "Department"}}</td><td class="v">{{program.department}}</td>
      <td class="k">{{t "coe.print.gradeCard.dob" "Date of birth"}}</td><td class="v">{{#if student.dob}}{{date student.dob}}{{/if}}</td></tr>
  {{/if}}
  {{#if program.regulation}}<tr><td class="k">{{t "coe.print.gradeCard.regulation" "Regulation"}}</td><td class="v" colspan="3">{{program.regulation}}</td></tr>{{/if}}
</table>

<table class="grid">
  <thead><tr>
    <th>{{t "coe.print.gradeCard.sno" "S. No."}}</th><th>{{t "coe.print.gradeCard.code" "Course code"}}</th><th class="l">{{t "coe.print.gradeCard.course" "Course title"}}</th>
    <th>{{t "coe.print.gradeCard.credits" "Credits (C)"}}</th><th>{{t "coe.print.gradeCard.grade" "Grade"}}</th><th>{{t "coe.print.gradeCard.points" "Grade point (G)"}}</th>
    <th>{{t "coe.print.gradeCard.creditPoints" "Credit points (C × G)"}}</th><th>{{t "coe.print.gradeCard.result" "Result"}}</th>
  </tr></thead>
  <tbody>
    {{#each courses}}
      <tr>
        <td class="sn">{{inc @index}}</td><td class="c mono">{{code}}</td><td>{{title}}{{#if revalued}} *{{/if}}</td>
        <td class="c">{{num credits}}</td><td class="c"><b>{{grade}}</b></td><td class="c">{{points}}</td><td class="c">{{num creditPoints}}</td>
        <td class="c{{#unless pass}} ra{{/unless}}">{{result}}</td>
      </tr>
    {{/each}}
    <tr class="total"><td></td><td></td><td>{{t "coe.print.gradeCard.total" "Total"}}</td><td class="c">{{num totals.credits}}</td><td></td><td></td><td class="c">{{num totals.creditPoints}}</td><td></td></tr>
  </tbody>
</table>

<table class="grid sum">
  <thead><tr>
    <th>{{t "coe.print.gradeCard.creditsRegistered" "Credits registered"}}</th><th>{{t "coe.print.gradeCard.creditsEarned" "Credits earned"}}</th>
    <th>{{t "coe.print.gradeCard.sgpa" "SGPA"}}</th><th>{{t "coe.print.gradeCard.cumulative" "Cumulative credits earned"}}</th><th>{{t "coe.print.gradeCard.cgpa" "CGPA"}}</th>
    <th>{{t "coe.print.gradeCard.resultOverall" "Result"}}</th>
  </tr></thead>
  <tbody><tr>
    <td>{{num result.creditsRegistered}}</td><td>{{num result.creditsEarned}}</td><td>{{num result.sgpa}}</td><td>{{num result.cumulativeCredits}}</td><td>{{num result.cgpa}}</td>
    <td>{{#if result.pass}}{{t "coe.print.gradeCard.passed" "Pass"}}{{else}}{{t "coe.print.gradeCard.arrearsN" "{{n}} to reappear" n=result.arrears}}{{/if}}</td>
  </tr></tbody>
</table>
<p class="note">{{t "coe.print.gradeCard.legend" "P: passed · RA: to reappear · * re-evaluated. SGPA = Σ(C × G) / ΣC over the semester’s courses; CGPA = the same over every semester so far."}}</p>

{{#if scale.length}}
<div class="scale no-break">
  <div class="cap">{{t "coe.print.gradeCard.scale" "Grading system (UGC 10-point scale)"}}</div>
  <table class="grid">
    <tr><th>{{t "coe.print.gradeCard.letterGrade" "Letter grade"}}</th>{{#each scale}}<td><b>{{grade}}</b></td>{{/each}}<td><b>{{t "coe.print.gradeCard.absentShort" "Ab"}}</b></td></tr>
    <tr><th>{{t "coe.print.gradeCard.meaning" "Meaning"}}</th>{{#each scale}}<td>{{label}}</td>{{/each}}<td>{{t "coe.print.gradeCard.absent" "Absent"}}</td></tr>
    <tr><th>{{t "coe.print.gradeCard.points" "Grade point (G)"}}</th>{{#each scale}}<td>{{points}}</td>{{/each}}<td>0</td></tr>
    <tr><th>{{t "coe.print.gradeCard.marksRange" "Marks (%)"}}</th>{{#each scale}}<td>{{range}}</td>{{/each}}<td>—</td></tr>
  </table>
</div>
{{/if}}

<div class="place no-break">
  {{#if institution.city}}<div>{{t "coe.print.gradeCard.place" "Place"}}: <b>{{institution.city}}</b></div>{{/if}}
  <div>{{t "coe.print.gradeCard.dateOfIssue" "Date of issue"}}: {{#if session.publishedAt}}<b>{{date session.publishedAt}}</b>{{else}}<span class="fill">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>{{/if}}</div>
</div>
<div class="signs no-break">
  <div>{{t "coe.print.gradeCard.checkedBy" "Checked by"}}</div>
  <div class="sealed">{{> seal role="CONTROLLER" label=(t "coe.print.gradeCard.seal" "Seal")}}{{t "coe.print.gradeCard.controller" "Controller of Examinations"}}</div>
</div>
{{> footer}}
