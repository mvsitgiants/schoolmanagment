{{!-- Invigilation duty chart (A4) for an exam: every session and room with its invigilators and a signature column,
      then each teacher's number of duties. exam.name · sessions[] {date, startTime, endTime, status, rooms[] {room,
      students, invigilators}} · teachers[] {name, designation, duties}. Data from services/examSeating.js
      (dutyChartPrint). --}}
<style>
  .sess { font-weight: 700; font-size: 9.6pt; margin: 4.5mm 0 1.3mm } .sess .draft { font-weight: 700; font-size: 8pt; border: .3mm solid #333; padding: 0 1.5mm; margin-left: 2mm }
  table.grid { font-size: 9pt } table.grid th { text-align: center; vertical-align: middle } table.grid th.l { text-align: left }
  table.grid td.sn { width: 10mm; text-align: center } table.grid td.c { text-align: center; white-space: nowrap } table.grid td.sig { width: 38mm }
  .signs { margin-top: 26mm } .signs .sealed { position: relative } .signs .sealed .seal { position: absolute; left: 50%; bottom: 100%; transform: translate(-50%, -1.5mm); margin: 0 }
</style>
{{#> letterhead}}{{/letterhead}}
<div class="doc-title">{{t "exams.print.duty.title" "Invigilation duty chart"}}</div>
<div class="doc-sub">{{exam.name}}</div>
{{#each sessions}}
<div class="sess no-break">{{date date}} · {{startTime}}{{#if endTime}}–{{endTime}}{{/if}}{{#if (eq status "DRAFT")}}<span class="draft">{{t "exams.print.seating.draft" "Draft"}}</span>{{/if}}</div>
<table class="grid">
  <thead><tr><th>{{t "exams.print.door.sno" "S. No."}}</th><th style="width:26mm">{{t "exams.print.door.room" "Room"}}</th><th style="width:20mm">{{t "exams.print.seating.count" "Students"}}</th><th class="l">{{t "exams.print.seating.invigilators" "Invigilators"}}</th><th>{{t "exams.print.duty.sign" "Signature"}}</th></tr></thead>
  <tbody>{{#each rooms}}<tr><td class="sn">{{inc @index}}</td><td class="c"><b>{{room}}</b></td><td class="c">{{students}}</td><td>{{invigilators}}</td><td class="sig"></td></tr>{{/each}}</tbody>
</table>
{{/each}}
<div class="sess no-break">{{t "exams.print.duty.totals" "Duties per teacher"}}</div>
<table class="grid">
  <thead><tr><th>{{t "exams.print.door.sno" "S. No."}}</th><th class="l">{{t "exams.print.duty.name" "Name"}}</th><th class="l">{{t "exams.print.duty.designation" "Designation"}}</th><th style="width:26mm">{{t "exams.print.duty.count" "No. of duties"}}</th></tr></thead>
  <tbody>{{#each teachers}}<tr><td class="sn">{{inc @index}}</td><td>{{name}}</td><td>{{designation}}</td><td class="c"><b>{{duties}}</b></td></tr>{{/each}}</tbody>
</table>
<p class="note">{{t "exams.print.duty.note" "Invigilators report to the exam office 30 minutes before each paper to collect the question papers and answer books, and sign against their duty."}}</p>
<div class="signs no-break">
  <div>{{t "exams.print.seating.inchargeSign" "Controller / Exam in-charge"}}</div>
  <div class="sealed"><div class="seal">{{t "exams.print.reportCard.seal" "School seal"}}</div>{{t "exams.print.reportCard.principalSign" "Principal"}}</div>
</div>
{{> footer}}
