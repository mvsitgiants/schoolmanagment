{{!-- Question paper (A4): one set as the students get it — the exam, class, subject, date and time, roll number boxes,
      general instructions, then each section with its questions numbered through the paper, marks on the right, MCQ
      options a)–d) and "OR" for an internal choice. Data from services/questionPapers.js (questionPaperPrint). --}}
<style>
  .qp-set { text-align: right; font-size: 9pt; color: #5B616E }
  .qp-set b { display: block; font-size: 20pt; line-height: 1; color: #12141C; border: 1.5px solid #12141C; border-radius: 2mm; padding: 1mm 3mm; margin-top: 1mm }
  .qp-draft { margin: 2mm 0; padding: 1.5mm 3mm; border: 1px dashed #C2410C; color: #C2410C; font-size: 8.5pt; text-align: center; font-weight: 600; letter-spacing: .04em }
  h1.qp-title { font-size: 13pt; text-align: center; margin: 3mm 0 .5mm; text-transform: uppercase; letter-spacing: .06em }
  .qp-sub { text-align: center; font-size: 10.5pt; font-weight: 600; margin-bottom: 3mm }
  .qp-facts { display: flex; justify-content: space-between; gap: 4mm; font-size: 9.5pt; border-top: 1px solid #12141C; border-bottom: 1px solid #12141C; padding: 1.5mm 0; margin-bottom: 3mm }
  .qp-roll { display: flex; align-items: center; gap: 2mm; justify-content: flex-end; font-size: 9pt; margin-bottom: 3mm }
  .qp-roll span.box { width: 6mm; height: 7mm; border: 1px solid #12141C; display: inline-block }
  .qp-ins { font-size: 9pt; margin-bottom: 4mm }
  .qp-ins ol { margin: 1mm 0 0 5mm; padding: 0 }
  .qp-ins li { margin: .4mm 0 }
  .qp-sec { margin-top: 4mm }
  .qp-sec h2 { font-size: 10.5pt; text-align: center; margin: 0 0 1mm; text-transform: uppercase; letter-spacing: .05em }
  .qp-sec .note { font-size: 9pt; font-style: italic; text-align: center; color: #3A3F4B; margin-bottom: 2mm }
  .qp-q { display: grid; grid-template-columns: 8mm 1fr 10mm; gap: 1mm; font-size: 10pt; margin: 1.6mm 0; break-inside: avoid }
  .qp-q .no { font-weight: 600 }
  .qp-q .mk { text-align: right; white-space: nowrap; font-size: 9pt }
  .qp-q .txt { white-space: normal }
  .qp-opts { display: grid; grid-template-columns: 1fr 1fr; gap: .6mm 6mm; margin-top: 1mm }
  .qp-or { text-align: center; font-weight: 700; font-size: 9.5pt; margin: 1mm 0; letter-spacing: .08em }
  .qp-end { text-align: center; margin-top: 8mm; font-size: 9pt; letter-spacing: .2em; color: #5B616E }
</style>
{{#> letterhead}}{{#if paper.showSet}}<div class="qp-set">{{t "questionPapers.print.set" "Set"}}<b>{{paper.set}}</b></div>{{/if}}{{/letterhead}}
{{#if paper.draft}}<div class="qp-draft">{{t "questionPapers.print.draft" "DRAFT — this paper has not been approved yet"}}</div>{{/if}}
<h1 class="qp-title">{{exam.name}}{{#if exam.year}} · {{exam.year}}{{/if}}</h1>
<div class="qp-sub">{{paper.class}} · {{paper.subject}}{{#if paper.subjectCode}} ({{paper.subjectCode}}){{/if}}</div>
<div class="qp-facts">
  <span>{{#if paper.date}}{{t "questionPapers.print.date" "Date"}}: {{date paper.date}}{{#if paper.startTime}} · {{paper.startTime}}{{#if paper.endTime}} – {{paper.endTime}}{{/if}}{{/if}}{{/if}}</span>
  <span>{{#if paper.durationMin}}{{t "questionPapers.print.time" "Time allowed"}}: {{#if (eq paper.hours 1)}}{{t "questionPapers.print.hour" "1 hour"}}{{else if paper.hours}}{{t "questionPapers.print.hours" "{{n}} hours" n=paper.hours}}{{else}}{{t "questionPapers.print.minutes" "{{n}} minutes" n=paper.durationMin}}{{/if}}{{/if}}</span>
  <span>{{t "questionPapers.print.maxMarks" "Maximum marks"}}: <b>{{paper.maxMarks}}</b></span>
</div>
<div class="qp-roll">{{t "questionPapers.print.rollNo" "Roll No."}} {{#each rollBoxes}}<span class="box"></span>{{/each}}</div>
{{#if paper.instructions.length}}
<div class="qp-ins"><b>{{t "questionPapers.print.instructions" "General instructions"}}</b>
  <ol>{{#each paper.instructions}}<li>{{this}}</li>{{/each}}</ol>
</div>
{{/if}}
{{#each sections}}
<div class="qp-sec">
  <h2>{{title}}</h2>
  <div class="note">{{#if instructions}}{{instructions}} {{/if}}{{#if attemptAny}}{{t "questionPapers.print.attemptAny" "Attempt any {{n}} of the {{of}} questions." n=attempt of=count}} {{/if}}({{attempt}} × {{num marks}} = {{num total}})</div>
  {{#each questions}}
  <div class="qp-q">
    <span class="no">{{no}}.</span>
    <div class="txt">{{lines text}}{{#if trueFalse}} <i>({{t "questionPapers.print.trueFalse" "True / False"}})</i>{{/if}}{{#if multi}} <i>({{t "questionPapers.print.multi" "more than one may be correct"}})</i>{{/if}}
      {{#if hasOptions}}<div class="qp-opts">{{#each options}}<span>{{letter}}) {{text}}</span>{{/each}}</div>{{/if}}
      {{#if or}}
        <div class="qp-or">{{t "questionPapers.print.or" "OR"}}</div>
        {{lines or.text}}{{#if or.trueFalse}} <i>({{t "questionPapers.print.trueFalse" "True / False"}})</i>{{/if}}
        {{#if or.hasOptions}}<div class="qp-opts">{{#each or.options}}<span>{{letter}}) {{text}}</span>{{/each}}</div>{{/if}}
      {{/if}}
    </div>
    <span class="mk">[{{num marks}}]</span>
  </div>
  {{/each}}
</div>
{{/each}}
<div class="qp-end">{{t "questionPapers.print.end" "— END OF PAPER —"}}</div>
{{> footer}}
