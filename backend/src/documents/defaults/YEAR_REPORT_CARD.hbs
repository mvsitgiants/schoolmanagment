{{!-- Year-end report card (A4): every subject's % in each exam type that counts (with its share of the year), the
      weighted final % and grade, the overall result, the year's attendance and the class teacher's remark. --}}
<style>
  h1 { font-size: 13pt; text-align: center; letter-spacing: .08em; text-transform: uppercase; margin: 4mm 0 1mm }
  .sub { text-align: center; font-size: 10.5pt; font-weight: 600; margin-bottom: 5mm }
  .who { display: grid; grid-template-columns: 1fr 1fr; gap: 1mm 8mm; font-size: 9.5pt; margin-bottom: 5mm }
  .who span { color: #5B616E }
  table.m { width: 100%; border-collapse: collapse; font-size: 9.5pt }
  table.m th { font-weight: 600; color: #5B616E; border-bottom: 1px solid #C8CCD4; padding: 1.6mm 1.5mm; background: #F6F7F9; text-align: center }
  table.m th:first-child, table.m td:first-child { text-align: left }
  table.m th small { display: block; font-weight: 400; font-size: 7.5pt }
  table.m td { padding: 1.5mm; border-bottom: 1px solid #EEF0F3; text-align: center; white-space: nowrap }
  table.m td.fin, table.m th.fin { background: #F1F7F7; font-weight: 700 }
  .low { color: #C0392B; font-weight: 600 }
  .summary { display: flex; gap: 4mm; margin-top: 5mm }
  .summary div { flex: 1; border: 1px solid #E3E5EA; border-radius: 2mm; padding: 2mm 3mm; font-size: 9pt }
  .summary b { display: block; font-size: 12pt; margin-top: .5mm }
  .note { margin-top: 3mm; font-size: 8.5pt; color: #5B616E }
  .remark { margin-top: 4mm; border: 1px solid #E3E5EA; border-radius: 2mm; padding: 2.5mm 3mm; font-size: 9.5pt; min-height: 12mm }
  .scale { margin-top: 4mm; font-size: 8pt; color: #5B616E }
  .scale span { display: inline-block; margin-right: 4mm }
  .sign { margin-top: 16mm; display: flex; justify-content: space-between; gap: 10mm; font-size: 9.5pt }
  .sign div { flex: 1; text-align: center; border-top: 1px solid #8B90A0; padding-top: 2mm }
  .draft { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 50pt; font-weight: 800; color: rgba(185,130,31,.16); transform: rotate(-20deg); pointer-events: none }
</style>
{{#unless published}}<div class="draft">{{t "exams.print.yearCard.stampProvisional" "PROVISIONAL"}}</div>{{/unless}}
{{#> letterhead}}{{/letterhead}}
<h1>{{t "exams.print.yearCard.title" "Annual report card"}}</h1>
<div class="sub">{{t "exams.print.yearCard.session" "Academic year"}} {{year}}</div>
<div class="who">
  <div><span>{{t "exams.print.reportCard.name" "Name"}}:</span> <b>{{student.name}}</b></div>
  <div><span>{{t "exams.print.reportCard.class" "Class"}}:</span> {{student.class}}</div>
  <div><span>{{t "exams.print.reportCard.admissionNo" "Admission No."}}:</span> <span class="mono">{{student.admissionNo}}</span></div>
  <div><span>{{t "exams.print.reportCard.rollNo" "Roll No."}}:</span> {{default student.rollNo "—"}}</div>
  {{#if student.father}}<div><span>{{t "exams.print.reportCard.father" "Father’s name"}}:</span> {{student.father}}</div>{{/if}}
  {{#if student.mother}}<div><span>{{t "exams.print.reportCard.mother" "Mother’s name"}}:</span> {{student.mother}}</div>{{/if}}
</div>

<table class="m">
  <thead><tr>
    <th>{{t "exams.print.reportCard.subject" "Subject"}}</th>
    {{#each columns}}<th>{{name}}<small>{{num share}}%</small></th>{{/each}}
    <th class="fin">{{t "exams.print.yearCard.final" "Final %"}}</th>
    <th>{{t "exams.print.reportCard.grade" "Grade"}}</th>
  </tr></thead>
  <tbody>
    {{#each subjects}}
      <tr>
        <td>{{subject}}</td>
        {{#each parts}}<td>{{default (num pct) "—"}}</td>{{/each}}
        <td class="fin{{#if below}} low{{/if}}">{{default (num pct) "—"}}</td>
        <td>{{default grade "—"}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>
<div class="note">{{t "exams.print.yearCard.how" "Each column is the % in that kind of exam; the final % weighs them by the share shown under each heading."}}</div>

<div class="summary">
  <div>{{t "exams.print.yearCard.overall" "Overall"}}<b>{{#if result.pct}}{{num result.pct}}%{{#if result.grade}} · {{result.grade}}{{/if}}{{else}}—{{/if}}</b></div>
  <div>{{t "exams.print.reportCard.result" "Result"}}<b class="{{#unless result.pass}}low{{/unless}}">{{result.label}}</b></div>
  {{#if result.rank}}<div>{{t "exams.print.reportCard.rank" "Rank in class"}}<b>{{result.rank}} / {{result.of}}</b></div>{{/if}}
  <div>{{t "exams.print.reportCard.attendance" "Attendance"}}<b>{{#if attendance.working}}{{num attendance.present}} / {{attendance.working}}{{#if attendance.pct}} ({{num attendance.pct}}%){{/if}}{{else}}—{{/if}}</b></div>
</div>
{{#if result.failed.length}}<div class="note">{{t "exams.print.yearCard.below" "Below the pass mark"}} ({{rules.passPct}}%): {{#each result.failed}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}

<div class="remark"><b>{{t "exams.print.reportCard.remark" "Class teacher’s remark"}}:</b> {{remark}}</div>

{{#if bands.length}}
<div class="scale"><b>{{t "exams.print.reportCard.scale" "Grading scale"}}:</b>
  {{#each bands}}<span>{{grade}} {{num min}}–{{num max}}%</span>{{/each}}
</div>
{{/if}}

<div class="sign">
  <div>{{t "exams.print.reportCard.teacherSign" "Class teacher"}}</div>
  <div>{{t "exams.print.reportCard.principalSign" "Principal"}}</div>
  <div>{{t "exams.print.reportCard.parentSign" "Parent / guardian"}}</div>
</div>
{{> footer}}
