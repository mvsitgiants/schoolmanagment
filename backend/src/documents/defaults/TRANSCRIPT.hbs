{{!-- Consolidated transcript (A4): every semester of the student's program with the latest attempt of each course,
      the SGPA per semester, the CGPA, its percentage equivalent and the classification. Provisional until every
      credit needed to graduate is earned. --}}
<style>
  h1 { font-size: 13pt; text-align: center; letter-spacing: .08em; text-transform: uppercase; margin: 4mm 0 1mm }
  .sub { text-align: center; font-size: 10.5pt; font-weight: 600; margin-bottom: 5mm }
  .who { display: grid; grid-template-columns: 1fr 1fr; gap: 1mm 8mm; font-size: 9.5pt; margin-bottom: 4mm }
  .who span { color: #5B616E }
  h2 { font-size: 9.5pt; margin: 4mm 0 1mm; text-transform: uppercase; letter-spacing: .05em; color: #3A3F4B; display: flex; justify-content: space-between }
  table.m { width: 100%; border-collapse: collapse; font-size: 8.5pt }
  table.m th { text-align: left; font-weight: 600; color: #5B616E; border-bottom: 1px solid #C8CCD4; padding: 1.2mm; background: #F6F7F9 }
  table.m td { padding: 1.1mm 1.2mm; border-bottom: 1px solid #EEF0F3 }
  table.m .n { text-align: right; white-space: nowrap }
  table.m .c { text-align: center }
  .ra { color: #C0392B; font-weight: 700 }
  .summary { display: flex; gap: 4mm; margin-top: 5mm }
  .summary div { flex: 1; border: 1px solid #E3E5EA; border-radius: 2mm; padding: 2mm 3mm; font-size: 9pt }
  .summary b { display: block; font-size: 12pt; margin-top: .5mm }
  .scale { margin-top: 3mm; font-size: 8pt; color: #5B616E }
  .scale span { display: inline-block; margin-right: 4mm }
  .sign { margin-top: 16mm; display: flex; justify-content: space-between; gap: 10mm; font-size: 9.5pt }
  .sign div { flex: 1; text-align: center; border-top: 1px solid #8B90A0; padding-top: 2mm }
  .draft { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 50pt; font-weight: 800; color: rgba(185,130,31,.16); transform: rotate(-20deg); pointer-events: none }
</style>
{{#unless result.complete}}<div class="draft">{{t "coe.print.transcript.provisional" "PROVISIONAL"}}</div>{{/unless}}
{{#> letterhead}}{{/letterhead}}
<h1>{{t "coe.print.transcript.title" "Consolidated grade transcript"}}</h1>
<div class="sub">{{program.name}}</div>
<div class="who">
  <div><span>{{t "coe.print.transcript.name" "Name"}}:</span> <b>{{student.name}}</b></div>
  <div><span>{{t "coe.print.transcript.registerNo" "Register No."}}:</span> <span class="mono">{{default student.registerNo student.admissionNo}}</span></div>
  {{#if student.dob}}<div><span>{{t "coe.print.transcript.dob" "Date of birth"}}:</span> {{date student.dob}}</div>{{/if}}
  <div><span>{{t "coe.print.transcript.batch" "Batch"}}:</span> {{student.batch}}</div>
  {{#if program.department}}<div><span>{{t "coe.print.transcript.department" "Department"}}:</span> {{program.department}}</div>{{/if}}
  {{#if program.regulation}}<div><span>{{t "coe.print.transcript.regulation" "Regulation"}}:</span> {{program.regulation}}</div>{{/if}}
</div>

{{#each semesters}}
  <h2><span>{{t "coe.print.transcript.semester" "Semester"}} {{semester}}</span><span>{{t "coe.print.transcript.sgpa" "SGPA"}} {{default (num sgpa) "—"}} · {{t "coe.print.transcript.credits" "Credits"}} {{num earned}} / {{num credits}}</span></h2>
  <table class="m">
    <thead><tr><th>{{t "coe.print.transcript.code" "Code"}}</th><th>{{t "coe.print.transcript.course" "Course"}}</th><th class="n">{{t "coe.print.transcript.credits" "Credits"}}</th><th class="c">{{t "coe.print.transcript.grade" "Grade"}}</th><th class="c">{{t "coe.print.transcript.points" "Points"}}</th><th>{{t "coe.print.transcript.passedIn" "Exam"}}</th></tr></thead>
    <tbody>
      {{#each courses}}<tr><td class="mono">{{code}}</td><td>{{title}}</td><td class="n">{{num credits}}</td><td class="c{{#unless pass}} ra{{/unless}}"><b>{{grade}}</b></td><td class="c">{{points}}</td><td>{{session}}</td></tr>{{/each}}
    </tbody>
  </table>
{{/each}}

<div class="summary">
  <div>{{t "coe.print.transcript.cgpa" "CGPA"}}<b>{{default (num result.cgpa) "—"}}</b></div>
  <div>{{t "coe.print.transcript.percentage" "Equivalent %"}}<b>{{#if result.pct}}{{num result.pct}}%{{else}}—{{/if}}</b></div>
  <div>{{t "coe.print.transcript.earned" "Credits earned"}}<b>{{num result.earned}}{{#if result.required}} / {{num result.required}}{{/if}}</b></div>
  <div>{{t "coe.print.transcript.classification" "Classification"}}<b>{{#if result.classification}}{{result.classification}}{{else}}—{{/if}}</b></div>
</div>
<div class="scale"><b>{{t "coe.print.transcript.scale" "Grading scale"}}:</b>
  {{#each scale}}<span>{{grade}} = {{points}}</span>{{/each}}
  · {{t "coe.print.transcript.pctNote" "Percentage = CGPA ×"}} {{result.multiplier}}
</div>

<div class="sign">
  <div>{{t "coe.print.transcript.preparedBy" "Prepared by"}}</div>
  <div>{{t "coe.print.transcript.controller" "Controller of Examinations"}}</div>
  <div>{{t "coe.print.transcript.principal" "Principal"}}</div>
</div>
{{> footer}}
