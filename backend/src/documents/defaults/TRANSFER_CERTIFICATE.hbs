{{!-- Transfer certificate (A4) in the CBSE prescribed format (state boards use the same rows).
      Top: Book No., Sl. No. (the TC number), Admission No., Affiliation No., School No., PEN / APAAR ID.
      Rows 1–23: student.name, student.mother, student.father / guardian, student.dob + dobWords, student.nationality,
      student.reserved (SC / ST / OBC), student.admissionDate + firstClass, tc.lastClass + lastClassWords, tc.lastExam + lastExamResult,
      tc.failed, tc.subjectsText, tc.promotedTo + promotedToWords, tc.feesPaidUpTo, tc.concession, tc.workingDays, tc.presentDays,
      tc.nccScoutGuide, tc.games, tc.conduct, tc.applicationDate, tc.issuedAt, tc.reason (+ tc.leavingDate), tc.remarks.
      Anything empty prints as a blank line to fill in by hand. Signed by the class teacher, the person who checked it and the Principal. --}}
<style>
  .frame { position: relative; display: flex; flex-direction: column; padding: 4mm 5mm }
  .tc-top { display: grid; grid-template-columns: 1fr auto; gap: 4mm; align-items: start; margin-top: 2mm; font-size: 8.8pt }
  .tc-ids { display: grid; grid-template-columns: repeat(3, auto); gap: 1.2mm 8mm; justify-content: start }
  .tc-ids span b { font-family: "JetBrains Mono", ui-monospace, monospace; font-weight: 600 }
  .tc-ids .blank { display: inline-block; min-width: 22mm; border-bottom: 0.25mm dotted #555 }
  .tc-qr { text-align: center; font-size: 6.4pt; color: #5B616E; line-height: 1.2 }
  .rows { margin-top: 1mm; font-size: 9.1pt; line-height: 1.42 }
  .row { display: flex; align-items: last baseline; gap: 2mm; padding: .45mm 0 }
  .row .n { flex: 0 0 6.5mm; align-self: first baseline }
  .row .k { flex: 0 1 auto; max-width: 60%; color: #22252C }
  .row .v { flex: 1 1 32%; min-width: 32%; border-bottom: 0.25mm dotted #555; font-weight: 600; min-height: 4.2mm; padding: 0 1mm }
  .row .v::before { content: '\200b' } /* an empty value still has a baseline */
  .row .w { font-weight: 400; color: #3B3F47; font-size: 8.4pt }
  .signs { margin-top: auto; padding-top: 24mm; align-items: flex-start }
  .signs .pr { position: relative } .signs .pr .seal { position: absolute; left: 50%; bottom: 100%; transform: translateX(-50%); margin: 0 0 2mm; width: 20mm; height: 20mm }
  .signs .sub { display: block; font-size: 7.2pt; color: #5B616E }
  .stamp { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 54pt; font-weight: 800; transform: rotate(-20deg); pointer-events: none }
  .stamp.draft { color: rgba(185,130,31,.16) } .stamp.void { color: rgba(214,69,69,.16) }
</style>
<div class="frame">
{{#if tc.requested}}<div class="stamp draft">{{t "students.print.tc.stampDraft" "NOT YET ISSUED"}}</div>{{/if}}
{{#if tc.cancelled}}<div class="stamp void">{{t "students.print.tc.stampCancelled" "CANCELLED"}}</div>{{/if}}
{{#> letterhead}}{{/letterhead}}
<div class="tc-top">
  <div class="tc-ids">
    <span>{{t "students.print.tc.bookNo" "Book No."}} {{#if tc.bookNo}}<b>{{tc.bookNo}}</b>{{else}}<span class="blank"></span>{{/if}}</span>
    <span>{{t "students.print.tc.slNo" "Sl. No."}} {{#if tc.no}}<b>{{tc.no}}</b>{{else}}<span class="blank"></span>{{/if}}</span>
    <span>{{t "students.print.tc.admissionNo" "Admission No."}} <b>{{student.admissionNo}}</b></span>
    {{#if institution.affiliationNo}}<span>{{t "students.print.tc.affiliationNo" "Affiliation No."}} <b>{{institution.affiliationNo}}</b></span>{{/if}}
    {{#if institution.schoolCode}}<span>{{t "students.print.tc.schoolNo" "School No."}} <b>{{institution.schoolCode}}</b></span>{{/if}}
    {{#if institution.udiseCode}}<span>{{t "students.print.tc.udise" "UDISE Code"}} <b>{{institution.udiseCode}}</b></span>{{/if}}
    {{#if student.pen}}<span>{{t "students.print.tc.pen" "PEN"}} <b>{{student.pen}}</b></span>{{/if}}
    {{#if student.apaarId}}<span>{{t "students.print.tc.apaar" "APAAR ID"}} <b>{{student.apaarId}}</b></span>{{/if}}
  </div>
  {{#if (and tc.verifyUrl @root.$layout.showQr)}}<div class="tc-qr">{{qr tc.verifyUrl 13}}<div>{{t "students.print.tc.scanToCheck" "Scan to check this TC"}}</div></div>{{/if}}
</div>
<div class="doc-title" style="margin:2.5mm 0 2mm">{{t "students.print.tc.title" "Transfer certificate"}}</div>
<div class="rows">
  <div class="row"><span class="n">1.</span><span class="k">{{t "students.print.tc.name" "Name of pupil"}}</span><span class="v">{{upper student.name}}</span></div>
  <div class="row"><span class="n">2.</span><span class="k">{{t "students.print.tc.mother" "Mother’s name"}}</span><span class="v">{{student.mother}}</span></div>
  <div class="row"><span class="n">3.</span><span class="k">{{t "students.print.tc.father" "Father’s / guardian’s name"}}</span><span class="v">{{#if student.father}}{{student.father}}{{else}}{{student.guardian}}{{/if}}</span></div>
  <div class="row"><span class="n">4.</span><span class="k">{{t "students.print.tc.dob" "Date of birth (in figures and words) according to the admission register"}}</span><span class="v">{{#if student.dob}}{{date student.dob}} <span class="w">({{dateWords student.dob}})</span>{{/if}}</span></div>
  <div class="row"><span class="n">5.</span><span class="k">{{t "students.print.tc.nationality" "Nationality"}}</span><span class="v">{{student.nationality}}</span></div>
  <div class="row"><span class="n">6.</span><span class="k">{{t "students.print.tc.category" "Whether the candidate belongs to Scheduled Caste, Scheduled Tribe or OBC"}}</span><span class="v">{{student.reserved}}</span></div>
  <div class="row"><span class="n">7.</span><span class="k">{{t "students.print.tc.admitted" "Date of first admission in the school, with class"}}</span><span class="v">{{#if student.admissionDate}}{{date student.admissionDate}}{{/if}}{{#if student.firstClass}}{{#if student.admissionDate}} — {{/if}}{{student.firstClass}}{{/if}}</span></div>
  <div class="row"><span class="n">8.</span><span class="k">{{t "students.print.tc.lastClass" "Class in which the pupil last studied (in figures and words)"}}</span><span class="v">{{tc.lastClass}}{{#if (classWords tc.lastClass)}} <span class="w">({{classWords tc.lastClass}})</span>{{/if}}</span></div>
  <div class="row"><span class="n">9.</span><span class="k">{{t "students.print.tc.lastExam" "School / board annual examination last taken, with result"}}</span><span class="v">{{tc.lastExam}}{{#if tc.lastExamResult}}{{#if tc.lastExam}} — {{/if}}{{tc.lastExamResult}}{{/if}}</span></div>
  <div class="row"><span class="n">10.</span><span class="k">{{t "students.print.tc.failed" "Whether failed; if so, once / twice in the same class"}}</span><span class="v">{{tc.failed}}</span></div>
  <div class="row"><span class="n">11.</span><span class="k">{{t "students.print.tc.subjects" "Subjects studied"}}</span><span class="v">{{tc.subjectsText}}</span></div>
  <div class="row"><span class="n">12.</span><span class="k">{{t "students.print.tc.promotion" "Whether qualified for promotion to the higher class; if so, to which class (in figures and words)"}}</span><span class="v">{{tc.promotedTo}}{{#if (classWords tc.promotedTo)}} <span class="w">({{classWords tc.promotedTo}})</span>{{/if}}</span></div>
  <div class="row"><span class="n">13.</span><span class="k">{{t "students.print.tc.fees" "Month up to which the pupil has paid school dues"}}</span><span class="v">{{tc.feesPaidUpTo}}</span></div>
  <div class="row"><span class="n">14.</span><span class="k">{{t "students.print.tc.concession" "Any fee concession availed; if so, the nature of the concession"}}</span><span class="v">{{tc.concession}}</span></div>
  <div class="row"><span class="n">15.</span><span class="k">{{t "students.print.tc.workingDays" "Total no. of working days in the academic session"}}</span><span class="v">{{num tc.workingDays}}</span></div>
  <div class="row"><span class="n">16.</span><span class="k">{{t "students.print.tc.presentDays" "Total no. of working days the pupil was present"}}</span><span class="v">{{num tc.presentDays}}</span></div>
  <div class="row"><span class="n">17.</span><span class="k">{{t "students.print.tc.ncc" "Whether NCC cadet / boy scout / girl guide (give details)"}}</span><span class="v">{{tc.nccScoutGuide}}</span></div>
  <div class="row"><span class="n">18.</span><span class="k">{{t "students.print.tc.games" "Games played or extra-curricular activities taken part in (mention achievement level)"}}</span><span class="v">{{tc.games}}</span></div>
  <div class="row"><span class="n">19.</span><span class="k">{{t "students.print.tc.conduct" "General conduct"}}</span><span class="v">{{tc.conduct}}</span></div>
  <div class="row"><span class="n">20.</span><span class="k">{{t "students.print.tc.applicationDate" "Date of application for the certificate"}}</span><span class="v">{{date tc.applicationDate}}</span></div>
  <div class="row"><span class="n">21.</span><span class="k">{{t "students.print.tc.issueDate" "Date of issue of the certificate"}}</span><span class="v">{{date tc.issuedAt}}</span></div>
  <div class="row"><span class="n">22.</span><span class="k">{{t "students.print.tc.reason" "Reason for leaving the school"}}</span><span class="v">{{tc.reason}}{{#if (and tc.reasonText (ne tc.reasonText tc.reason))}} — {{tc.reasonText}}{{/if}}{{#if tc.leavingDate}} <span class="w">({{t "students.print.tc.struckOff" "name struck off the rolls on {{date}}" date=(date tc.leavingDate)}})</span>{{/if}}</span></div>
  <div class="row"><span class="n">23.</span><span class="k">{{t "students.print.tc.remarks" "Any other remarks"}}</span><span class="v">{{tc.remarks}}</span></div>
</div>
<div class="signs">
  <div>{{t "students.print.tc.classTeacher" "Signature of Class Teacher"}}</div>
  <div>{{t "students.print.tc.checkedBy" "Checked by"}}<span class="sub">{{t "students.print.tc.checkedByHint" "(State full name and designation)"}}</span></div>
  <div class="pr">{{> seal role="PRINCIPAL" label=(t "students.print.tc.seal" "School seal")}}{{t "students.print.tc.principal" "Signature of Principal"}}{{#if tc.issuedBy}}<span class="sub">{{t "students.print.tc.issuedBy" "Issued by {{name}}" name=tc.issuedBy}}</span>{{/if}}</div>
</div>
{{#if tc.cancelled}}<p class="note" style="margin-top:3mm">{{t "students.print.tc.cancelledNote" "Cancelled: {{reason}}" reason=tc.cancelReason}}</p>{{/if}}
</div>
{{> footer}}
