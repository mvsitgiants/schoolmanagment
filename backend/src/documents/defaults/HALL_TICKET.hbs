{{!-- Admit card / hall ticket (A4) for one exam.
      exam.name, exam.year (session), exam.instructionLines[] · student.name, rollNo, admissionNo, class, father, dob,
      student.photo (else an "Affix photograph" box) · seat {room, seat} when every paper has the same one ·
      papers[] {date, dayLabel, startTime, endTime, subject, code, gradeOnly, room, seat} · seated · classTeacher ·
      exam.verifyUrl (QR, checked at the exam door). --}}
<style>
  .ac-title { text-align: center; font-family: "Noto Serif", Georgia, "Times New Roman", serif; font-size: 16pt; font-weight: 700; letter-spacing: .2em; margin: 4mm 0 .5mm }
  .ac-sub { text-align: center; font-size: 10pt; font-weight: 600; margin-bottom: 4mm }
  .who { display: grid; grid-template-columns: 1fr 30mm; gap: 5mm; align-items: start; margin-bottom: 4mm }
  .who table.kv { font-size: 9.6pt } .who table.kv td { padding: .8mm 1.5mm .8mm 0 } .who table.kv td.k { padding-right: 4mm }
  .ph { display: flex; flex-direction: column; align-items: center; gap: 2mm }
  .qr { text-align: center; font-size: 6.6pt; color: #5B616E; line-height: 1.15 }
  table.grid { font-size: 9.2pt } table.grid th { text-align: center; vertical-align: middle } table.grid td { vertical-align: middle; height: 7mm; padding: .6mm 2mm }
  table.grid td.c { text-align: center; white-space: nowrap }
  table.grid .w-date { width: 22mm } table.grid .w-day { width: 22mm } table.grid .w-time { width: 26mm } table.grid .w-seat { width: 24mm } table.grid .w-inv { width: 34mm }
  .ins { margin-top: 4mm; font-size: 8.6pt } .ins b { font-size: 9.4pt } .ins ol { margin: 1.2mm 0 0; padding-left: 5mm } .ins li { margin: .3mm 0 }
  .ins .also { margin-top: 2mm; font-weight: 600 }
  .signs { margin-top: 21mm } .signs .sealed { position: relative } .signs .sealed .seal { position: absolute; left: 50%; bottom: 100%; transform: translate(-50%, -1mm); margin: 0; width: 18mm; height: 18mm }
</style>
{{#> letterhead}}{{/letterhead}}
<div class="ac-title">{{t "exams.print.hallTicket.admitCard" "ADMIT CARD"}}</div>
<div class="ac-sub">{{exam.name}}{{#if exam.year}} · {{t "exams.print.reportCard.session" "Academic session {{year}}" year=exam.year}}{{/if}}</div>

<div class="who">
  <table class="kv">
    <tr><td class="k">{{t "exams.print.hallTicket.name" "Candidate’s name"}}</td><td class="v">{{upper student.name}}</td></tr>
    <tr><td class="k">{{t "exams.print.hallTicket.rollNo" "Roll No."}}</td><td class="v mono" style="font-size:10pt">{{#if student.rollNo}}{{student.rollNo}}{{else}}<span class="fill">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>{{/if}}</td></tr>
    <tr><td class="k">{{t "exams.print.hallTicket.admissionNo" "Admission No."}}</td><td class="v mono">{{student.admissionNo}}</td></tr>
    <tr><td class="k">{{t "exams.print.reportCard.classSection" "Class & section"}}</td><td class="v">{{student.class}}</td></tr>
    {{#if student.father}}<tr><td class="k">{{t "exams.print.reportCard.father" "Father’s name"}}</td><td class="v">{{student.father}}</td></tr>{{/if}}
    {{#if student.dob}}<tr><td class="k">{{t "exams.print.reportCard.dob" "Date of birth"}}</td><td class="v">{{date student.dob}}</td></tr>{{/if}}
    <tr><td class="k">{{t "exams.print.hallTicket.centre" "Examination centre"}}</td><td class="v">{{institution.name}}{{#if seat}} · {{t "exams.print.hallTicket.roomSeat" "Room {{room}}, Seat {{seat}}" room=seat.room seat=seat.seat}}{{/if}}</td></tr>
  </table>
  <div class="ph">
    <div class="photo">{{#if student.photo}}<img src="{{student.photo}}" alt="" />{{else}}{{t "exams.print.hallTicket.photo" "Affix recent passport-size photograph"}}{{/if}}</div>
    {{#if exam.verifyUrl}}<div class="qr">{{qr exam.verifyUrl 17}}<br>{{t "exams.print.hallTicket.scanToCheck" "Scan at the exam door"}}</div>{{/if}}
  </div>
</div>

<table class="grid">
  <thead><tr>
    <th class="w-date">{{t "exams.print.hallTicket.date" "Date"}}</th><th class="w-day">{{t "exams.print.hallTicket.day" "Day"}}</th><th class="w-time">{{t "exams.print.hallTicket.time" "Time"}}</th>
    <th style="text-align:left">{{t "exams.print.hallTicket.subject" "Subject (code)"}}</th>
    {{#if seated}}{{#unless seat}}<th class="w-seat">{{t "exams.print.hallTicket.seat" "Room · Seat"}}</th>{{/unless}}{{/if}}
    <th class="w-inv">{{t "exams.print.hallTicket.invigilator" "Invigilator’s signature"}}</th>
  </tr></thead>
  <tbody>
    {{#each papers}}
      <tr>
        <td class="c">{{date date}}</td><td class="c">{{tc "exams.print.day" day dayLabel}}</td>
        <td class="c">{{#if startTime}}{{startTime}}{{#if endTime}}–{{endTime}}{{/if}}{{/if}}</td>
        <td>{{subject}}{{#if code}} <span class="mono">({{code}})</span>{{/if}}{{#if gradeOnly}} <span class="note">· {{t "exams.print.hallTicket.graded" "graded"}}</span>{{/if}}</td>
        {{#if ../seated}}{{#unless ../seat}}<td class="c">{{#if seat}}{{room}} · {{seat}}{{/if}}</td>{{/unless}}{{/if}}
        <td></td>
      </tr>
    {{/each}}
  </tbody>
</table>

<div class="ins">
  <b>{{t "exams.print.hallTicket.instructions" "Instructions to the candidate"}}</b>
  <ol>
    <li>{{t "exams.print.hallTicket.ins1" "Reach the examination hall at least 20 minutes before the paper begins."}}</li>
    <li>{{t "exams.print.hallTicket.ins2" "Bring this admit card to every paper and show it when asked. Without it you may not be allowed to sit the paper."}}</li>
    <li>{{t "exams.print.hallTicket.ins3" "Mobile phones, smart watches, calculators and other electronic devices are not allowed in the hall."}}</li>
    <li>{{t "exams.print.hallTicket.ins4" "Bring your own pens, pencils and geometry box. Do not borrow or lend anything during the paper."}}</li>
    <li>{{t "exams.print.hallTicket.ins5" "Write your roll number only in the space given on the answer book. Do not write anything on the question paper."}}</li>
    <li>{{t "exams.print.hallTicket.ins6" "You may not leave the hall during the first hour or the last 15 minutes of the paper."}}</li>
  </ol>
  {{#if exam.instructionLines.length}}
  <div class="also">{{t "exams.print.hallTicket.forThisExam" "For this examination"}}</div>
  <ol>{{#each exam.instructionLines}}<li>{{this}}</li>{{/each}}</ol>
  {{/if}}
</div>

<div class="signs no-break">
  <div>{{t "exams.print.hallTicket.studentSign" "Candidate"}}{{#if classTeacher}}<br><span class="note">&nbsp;</span>{{/if}}</div>
  <div>{{t "exams.print.hallTicket.teacherSign" "Class Teacher"}}{{#if classTeacher}}<br><span class="note">{{classTeacher}}</span>{{/if}}</div>
  <div class="sealed"><div class="seal">{{t "exams.print.reportCard.seal" "School seal"}}</div>{{t "exams.print.hallTicket.principalSign" "Principal / Controller of Examinations"}}{{#if classTeacher}}<br><span class="note">&nbsp;</span>{{/if}}</div>
</div>
{{> footer}}
