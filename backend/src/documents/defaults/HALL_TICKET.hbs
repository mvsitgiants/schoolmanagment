{{!-- Hall ticket / admit card (A5): the student, and their class's exam timetable. --}}
<style>
  h1 { font-size: 12pt; text-align: center; letter-spacing: .08em; text-transform: uppercase; margin: 4mm 0 1mm }
  .sub { text-align: center; font-size: 10pt; font-weight: 600; margin-bottom: 4mm }
  .who { display: grid; grid-template-columns: 1fr 26mm; gap: 4mm; font-size: 9.5pt; margin-bottom: 4mm }
  .who table td { padding: .8mm 2mm .8mm 0; vertical-align: top }
  .who table td.k { color: #5B616E; width: 30mm }
  .photo { border: 1px dashed #A9AEB9; height: 32mm; display: flex; align-items: center; justify-content: center; font-size: 8pt; color: #8B90A0; text-align: center }
  table.tt { width: 100%; border-collapse: collapse; font-size: 9pt }
  table.tt th { text-align: left; font-weight: 600; color: #5B616E; border-bottom: 1px solid #C8CCD4; padding: 1.5mm 1mm }
  table.tt td { padding: 1.3mm 1mm; border-bottom: 1px solid #EEF0F3 }
  table.tt .n { text-align: right; white-space: nowrap }
  .ins { margin-top: 4mm; font-size: 8.5pt; color: #3A3F4B; white-space: pre-line }
  .sign { margin-top: 12mm; display: flex; justify-content: space-between; gap: 8mm; font-size: 9pt }
  .sign div { flex: 1; text-align: center; border-top: 1px solid #8B90A0; padding-top: 1.5mm }
</style>
{{#> letterhead}}{{/letterhead}}
<h1>{{t "exams.print.hallTicket.title" "Hall ticket"}}</h1>
<div class="sub">{{exam.name}}{{#if exam.year}} · {{exam.year}}{{/if}}</div>
<div class="who">
  <table>
    <tr><td class="k">{{t "exams.print.hallTicket.name" "Name"}}</td><td><b>{{student.name}}</b></td></tr>
    <tr><td class="k">{{t "exams.print.hallTicket.class" "Class"}}</td><td>{{student.class}}</td></tr>
    <tr><td class="k">{{t "exams.print.hallTicket.rollNo" "Roll No."}}</td><td class="mono">{{default student.rollNo "—"}}</td></tr>
    <tr><td class="k">{{t "exams.print.hallTicket.admissionNo" "Admission No."}}</td><td class="mono">{{student.admissionNo}}</td></tr>
    {{#if student.father}}<tr><td class="k">{{t "exams.print.hallTicket.father" "Father’s name"}}</td><td>{{student.father}}</td></tr>{{/if}}
  </table>
  <div class="photo">{{t "exams.print.hallTicket.photo" "Paste photo"}}</div>
</div>
<table class="tt">
  <thead><tr><th>{{t "exams.print.hallTicket.date" "Date"}}</th><th>{{t "exams.print.hallTicket.time" "Time"}}</th><th>{{t "exams.print.hallTicket.subject" "Subject"}}</th><th class="n">{{t "exams.print.hallTicket.maxMarks" "Max. marks"}}</th>{{#if seated}}<th>{{t "exams.print.hallTicket.seat" "Room · Seat"}}</th>{{/if}}</tr></thead>
  <tbody>
    {{#each papers}}
      <tr><td>{{date date}}</td><td>{{#if startTime}}{{startTime}}{{#if endTime}} – {{endTime}}{{/if}}{{else}}—{{/if}}</td><td>{{subject}}</td><td class="n">{{#if gradeOnly}}{{t "exams.print.hallTicket.graded" "Grade"}}{{else}}{{maxMarks}}{{/if}}</td>{{#if ../seated}}<td class="mono">{{#if seat}}<b>{{room}}</b> · {{seat}}{{else}}—{{/if}}</td>{{/if}}</tr>
    {{/each}}
  </tbody>
</table>
{{#if exam.instructions}}<div class="ins"><b>{{t "exams.print.hallTicket.instructions" "Instructions"}}</b><br>{{exam.instructions}}</div>{{/if}}
<div class="sign">
  <div>{{t "exams.print.hallTicket.studentSign" "Student"}}</div>
  <div>{{t "exams.print.hallTicket.teacherSign" "Class teacher"}}</div>
  <div>{{t "exams.print.hallTicket.principalSign" "Principal"}}</div>
</div>
{{> footer}}
