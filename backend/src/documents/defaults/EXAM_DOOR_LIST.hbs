{{!-- Exam seating notice (A4) for the notice board and room doors: for one session, each room and the roll numbers
      of each class-section sitting in it. exam.name · session {date, startTime, endTime} · status ·
      rooms[] {name, code, students, invigilators[], runs[] {section, from, to, count}}.
      Data from services/examSeating.js (doorListPrint). --}}
<style>
  .when { width: 100%; font-size: 10.5pt; border-top: .35mm solid #12141C; border-bottom: .35mm solid #12141C; margin-bottom: 4mm }
  .when td { padding: 1.2mm 0 } .when td.r { text-align: right }
  table.grid { font-size: 10.5pt } table.grid th { text-align: center; vertical-align: middle }
  table.grid td.sn { width: 10mm; text-align: center } table.grid td.room { width: 34mm; font-weight: 700; font-size: 11.5pt }
  table.grid td.c { text-align: center; width: 22mm; font-weight: 600 }
  .run { display: inline-block; margin: .3mm 5mm .3mm 0; white-space: nowrap } .run b { font-weight: 700 }
  .draft { font-weight: 700 }
  .signs { margin-top: 18mm }
</style>
{{#> letterhead}}{{/letterhead}}
<div class="doc-title">{{t "exams.print.door.title" "Examination seating arrangement"}}</div>
<div class="doc-sub">{{exam.name}}{{#if (eq status "DRAFT")}} · <span class="draft">{{t "exams.print.seating.draft" "Draft"}}</span>{{/if}}</div>
<table class="when"><tr>
  <td>{{t "exams.print.door.date" "Date"}}: <b>{{date session.date}}</b></td>
  <td class="r">{{t "exams.print.door.time" "Time"}}: <b>{{session.startTime}}{{#if session.endTime}} – {{session.endTime}}{{/if}}</b></td>
</tr></table>
<table class="grid">
  <thead><tr><th>{{t "exams.print.door.sno" "S. No."}}</th><th>{{t "exams.print.door.room" "Room"}}</th><th style="text-align:left">{{t "exams.print.door.who" "Class & roll numbers"}}</th><th>{{t "exams.print.seating.count" "Students"}}</th></tr></thead>
  <tbody>
  {{#each rooms}}
  <tr>
    <td class="sn">{{inc @index}}</td>
    <td class="room">{{#if code}}{{code}}{{else}}{{name}}{{/if}}{{#if (and code (ne code name))}}<div class="note" style="font-weight:400">{{name}}</div>{{/if}}</td>
    <td>{{#each runs}}<span class="run"><b>{{section}}</b> {{#if from}}{{from}}{{#if (ne from to)}}–{{to}}{{/if}}{{/if}} ({{count}})</span>{{/each}}</td>
    <td class="c">{{students}}</td>
  </tr>
  {{/each}}
  </tbody>
</table>
<p class="note">{{t "exams.print.door.how" "Find your class and roll number, then go to that room. Numbers in brackets are how many students of the class sit there."}}</p>
<div class="signs no-break"><div style="flex:0 0 40%; margin-left:auto">{{t "exams.print.seating.inchargeSign" "Controller / Exam in-charge"}}</div></div>
{{> footer}}
