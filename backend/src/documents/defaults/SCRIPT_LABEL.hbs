{{!-- Answer-script stickers (A4 sheet, 3 × 10 stickers of 70 × 29.7 mm): the dummy number as a barcode, the course and
      session — never the student. Stick one on each booklet; the evaluator scans it on Exam controller › Marks. Set
      the page margins to 0 for label sheets. --}}
<style>
  .sheet { display: grid; grid-template-columns: repeat(3, 70mm); grid-auto-rows: 29.7mm; justify-content: center }
  .label { box-sizing: border-box; padding: 2mm 3.5mm; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; break-inside: avoid }
  .meta { font-size: 6.5pt; color: #5B616E; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
  .code { text-align: center }
  .code svg { max-width: 100%; height: 10mm }
  .no { font-family: ui-monospace, Menlo, monospace; font-size: 10pt; font-weight: 700; letter-spacing: .12em; text-align: center }
</style>
<div class="sheet">
  {{#each labels}}
  <div class="label">
    <div class="meta">{{../course.code}} · {{../session.month}}</div>
    <div class="code">{{barcode dummyNo 10}}</div>
    <div class="no">{{dummyNo}}</div>
  </div>
  {{/each}}
</div>
