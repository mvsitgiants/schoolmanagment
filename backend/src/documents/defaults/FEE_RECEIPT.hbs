{{!-- Fee receipt in the usual Indian school format. On A5 it prints one copy (Parent's copy); set the paper to A4 in
      the print template and the same receipt prints twice on one sheet — Parent's copy and Office copy, with a cut line
      (A4 landscape: side by side, A4 portrait: one above the other).
      Main fields: receipt.no, receipt.date, receipt.mode, receipt.reference, receipt.chequeBank, receipt.chequeDate,
      student.name, student.relation (S/o · D/o), student.parent, student.admissionNo, student.class, student.rollNo,
      student.year, rows[] {sl, name, period, amount}, summary {subtotal, concession, lateFee, total, paidEarlier, paid,
      balance}, {{words receipt.amount}}, receipt.verifyUrl (QR). --}}
<style>
  .sheet { container-type: inline-size }
  .copies { display: grid; grid-template-columns: 1fr; gap: 0 }
  .copies.two .cut { margin: 5mm 0 4mm }
  @container (min-width: 230mm) {
    .copies.two { grid-template-columns: 1fr 9mm 1fr; align-items: stretch }
    .copies.two .cut { margin: 0; border-top: 0; border-left: 0.35mm dashed #8A8F99; width: 0; justify-self: center; line-height: normal; display: flex; align-items: center }
    .copies.two .cut span { writing-mode: vertical-rl; padding: 2mm 0; margin-left: -1.6mm }
  }
  .rc { position: relative; font-size: 8.6pt }
  /* a compact letterhead: two receipts share an A4 sheet */
  .rc .lh-classic { grid-template-columns: 14mm 1fr 14mm; gap: 2mm } .rc .crest { max-width: 14mm; max-height: 14mm }
  .rc .hn-classic { font-size: 14pt } .rc .lh-trust, .rc .lh-board, .rc .lh-line { font-size: 7pt } .rc .head.center .lh { padding-bottom: 1.2mm }
  .rc .titlebar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2mm; margin: 2mm 0 1.5mm }
  .rc .titlebar .doc-title { margin: 0; font-size: 11.5pt }
  .rc .titlebar .end { text-align: right }
  .rc table.kv { margin-bottom: 1.8mm; border: 0.25mm solid #555 }
  .rc table.kv td { padding: .7mm 1.4mm; border-bottom: 0.2mm dotted #B5BAC3 }
  .rc table.kv tr:last-child td { border-bottom: 0 }
  .rc table.grid th, .rc table.grid td { padding: .7mm 1.5mm }
  .rc table.grid .sl { width: 11mm; text-align: center; white-space: nowrap }
  .rc table.grid .amt { width: 27mm }
  .rc table.grid .per { color: #5B616E }
  .rc table.grid tfoot td { background: transparent; font-weight: 400; border-top-width: 0.25mm }
  .rc table.grid tfoot tr.total td { font-weight: 700; background: #F1F3F6 }
  .rc .words { margin-top: 1.5mm }
  .rc .pay { margin-top: .6mm }
  .rc .terms { margin-top: 1.2mm }
  .rc .bottom { display: flex; align-items: flex-end; gap: 4mm; margin-top: 8mm }
  .rc .bottom .signs { flex: 1; margin-top: 0; gap: 6mm }
  .rc .bottom .signs > div { font-size: 8.2pt }
  .rc .qr { display: flex; flex-direction: column; align-items: center; gap: .4mm; font-size: 6pt; color: #5B616E; text-align: center; width: 15mm }
  .rc .bottom .signs > div { position: relative }
  .rc .by { position: absolute; left: 0; right: 0; top: 100%; font-size: 7pt; color: #5B616E }
  .rc { break-inside: avoid }
  /* A4 portrait: the two copies one above the other, a little tighter so both fit the sheet */
  @container (max-width: 229.9mm) {
    .copies.two .rc { font-size: 8.2pt }
    .copies.two .rc .hn-classic { font-size: 12.5pt } .copies.two .rc .lh-trust, .copies.two .rc .lh-board, .copies.two .rc .lh-line { font-size: 6.6pt; line-height: 1.25 }
    .copies.two .rc .titlebar { margin: 1.2mm 0 1mm }
    .copies.two .rc table.kv td, .copies.two .rc table.grid th, .copies.two .rc table.grid td { padding-top: .35mm; padding-bottom: .35mm }
    .copies.two .rc .words { margin-top: 1mm } .copies.two .rc .terms { margin-top: .6mm }
    .copies.two .rc .bottom { margin-top: 4mm } .copies.two .rc .qr { width: 20mm } .copies.two .rc .qr svg { width: 11mm; height: 11mm }
    .copies.two .cut { margin: 5mm 0 3mm }
  }
  .rc .void { position: absolute; inset: 35% 0 auto 0; text-align: center; font-size: 40pt; font-weight: 800; color: rgba(214,69,69,.18); transform: rotate(-18deg); pointer-events: none }
</style>
{{#*inline "receiptCopy"}}
<div class="rc">
  {{#if @root.receipt.cancelled}}<div class="void">{{t "fees.print.receipt.stampCancelled" "CANCELLED"}}</div>{{/if}}
  {{#> letterhead}}{{/letterhead}}
  <div class="titlebar">
    <span>{{t "fees.print.receipt.no" "Receipt No."}} <b class="mono">{{@root.receipt.no}}</b></span>
    <div class="doc-title">{{t "fees.print.receipt.title" "Fee receipt"}}</div>
    <span class="end"><span class="copy">{{copyLabel}}</span></span>
  </div>
  <table class="kv">
    <tr><td class="k">{{t "fees.print.receipt.date" "Date"}}</td><td class="v">{{date @root.receipt.date}}</td>
        <td class="k">{{t "fees.print.receipt.year" "Academic year"}}</td><td class="v">{{default @root.student.year "—"}}</td></tr>
    <tr><td class="k">{{t "fees.print.receipt.studentName" "Student's name"}}</td><td class="v upper">{{@root.student.name}}</td>
        <td class="k">{{t "fees.print.receipt.admissionNo" "Admission No."}}</td><td class="v mono">{{@root.student.admissionNo}}</td></tr>
    <tr><td class="k">{{#if @root.student.parent}}{{@root.student.relation}}{{else}}{{t "fees.print.receipt.fathersName" "Father's name"}}{{/if}}</td><td class="v">{{#if @root.student.parent}}{{@root.student.parent}}{{#if (eq @root.student.parentIs "MOTHER")}} <span class="muted">({{t "fees.print.receipt.mothersName" "mother"}})</span>{{/if}}{{#if (eq @root.student.parentIs "GUARDIAN")}} <span class="muted">({{t "fees.print.receipt.guardiansName" "guardian"}})</span>{{/if}}{{else}}<span class="fill">&nbsp;</span>{{/if}}</td>
        <td class="k">{{t "fees.print.receipt.classSection" "Class & Sec."}}</td><td class="v">{{#if @root.student.className}}{{@root.student.className}}{{#if @root.student.section}} – {{@root.student.section}}{{/if}}{{else}}{{@root.student.class}}{{/if}}{{#if @root.student.rollNo}} · {{t "fees.print.receipt.rollNo" "Roll No. {{no}}" no=@root.student.rollNo}}{{/if}}</td></tr>
  </table>
  <table class="grid">
    <thead><tr><th class="sl">{{t "fees.print.receipt.sl" "Sl. No."}}</th><th>{{t "fees.print.receipt.particulars" "Particulars"}}</th><th class="r amt">{{t "fees.print.receipt.amountRs" "Amount (₹)"}}</th></tr></thead>
    <tbody>
      {{#each @root.rows}}<tr><td class="sl">{{sl}}</td><td>{{name}} <span class="per">— {{period}}</span></td><td class="r">{{amount amount}}</td></tr>{{/each}}
    </tbody>
    <tfoot>
      {{#if (or @root.summary.concession @root.summary.lateFee)}}<tr><td></td><td class="r">{{t "fees.print.receipt.subtotal" "Sub-total"}}</td><td class="r">{{amount @root.summary.subtotal}}</td></tr>{{/if}}
      {{#if @root.summary.concession}}<tr><td></td><td class="r">{{t "fees.print.receipt.concession" "Less: Concession"}}</td><td class="r">− {{amount @root.summary.concession}}</td></tr>{{/if}}
      {{#if @root.summary.lateFee}}<tr><td></td><td class="r">{{t "fees.print.receipt.lateFine" "Add: Late fee / fine"}}</td><td class="r">{{amount @root.summary.lateFee}}</td></tr>{{/if}}
      <tr><td></td><td class="r">{{t "fees.print.receipt.total" "Total"}}</td><td class="r">{{amount @root.summary.total}}</td></tr>
      {{#if @root.summary.paidEarlier}}<tr><td></td><td class="r">{{t "fees.print.receipt.paidEarlier" "Paid on other receipts"}}</td><td class="r">− {{amount @root.summary.paidEarlier}}</td></tr>{{/if}}
      <tr class="total"><td></td><td class="r">{{t "fees.print.receipt.amountPaid" "Amount paid"}}</td><td class="r">{{money @root.receipt.amount}}</td></tr>
      <tr><td></td><td class="r">{{t "fees.print.receipt.balanceDue" "Balance due"}}</td><td class="r">{{money @root.summary.balance}}</td></tr>
    </tfoot>
  </table>
  <div class="words">{{t "fees.print.receipt.inWords" "In words:"}} <b>{{words @root.receipt.amount}}</b></div>
  <div class="pay">
    {{t "fees.print.receipt.mode" "Mode of payment:"}} <b>{{@root.receipt.mode}}</b>
    {{#if @root.receipt.cheque}}{{#if @root.receipt.reference}} · {{t "fees.print.receipt.chequeNo" "No. {{no}}" no=@root.receipt.reference}}{{/if}}{{#if @root.receipt.chequeBank}} · {{t "fees.print.receipt.drawnOn" "drawn on {{bank}}" bank=@root.receipt.chequeBank}}{{/if}}{{#if @root.receipt.chequeDate}} · {{t "fees.print.receipt.dated" "dated {{date}}" date=(date @root.receipt.chequeDate)}}{{/if}}
    {{else}}{{#if @root.receipt.reference}} · {{#if (or @root.receipt.upi @root.receipt.bank)}}{{t "fees.print.receipt.utr" "Transaction ref. (UTR) {{ref}}" ref=@root.receipt.reference}}{{else}}{{t "fees.print.receipt.ref" "Ref. {{ref}}" ref=@root.receipt.reference}}{{/if}}{{/if}}{{/if}}
  </div>
  {{#if @root.receipt.refunded}}<div class="pay">{{t "fees.print.receipt.refunded" "Refunded on this receipt: {{amount}}" amount=(money @root.receipt.refunded)}}</div>{{/if}}
  {{#if @root.receipt.cancelled}}<div class="pay"><b>{{t "fees.print.receipt.cancelledNote" "Cancelled: {{reason}}" reason=@root.receipt.cancelReason}}</b></div>{{/if}}
  <div class="note terms">{{#if @root.receipt.cheque}}{{t "fees.print.receipt.realisation" "Cheque / DD subject to realisation."}} {{/if}}{{t "fees.print.receipt.notRefundable" "Fees once paid are not refundable or transferable."}}</div>
  <div class="bottom">
    {{#if (and @root.receipt.verifyUrl @root.$layout.showQr)}}<div class="qr">{{qr @root.receipt.verifyUrl 13}}<span>{{t "fees.print.receipt.scanToCheck" "Scan to check this receipt"}}</span></div>{{/if}}
    <div class="signs">
      <div>{{t "fees.print.receipt.parentSign" "Signature of Parent"}}</div>
      <div>{{> seal role="ACCOUNTANT" label="Seal"}}{{t "fees.print.receipt.cashierSign" "Cashier / Accountant"}}{{#if @root.receipt.collectedBy}}<span class="by">{{t "fees.print.receipt.collectedBy" "Received by {{name}}" name=@root.receipt.collectedBy}}</span>{{/if}}</div>
    </div>
  </div>
</div>
{{/inline}}
<div class="sheet">
  {{#if (eq $layout.paper "A4")}}
  <div class="copies two">
    {{> receiptCopy copyLabel=(t "fees.print.receipt.parentCopy" "Parent's copy")}}
    <div class="cut"><span>{{t "fees.print.receipt.cutHere" "✂ cut here"}}</span></div>
    {{> receiptCopy copyLabel=(t "fees.print.receipt.officeCopy" "Office copy")}}
  </div>
  {{else}}
  <div class="copies">{{> receiptCopy copyLabel=(t "fees.print.receipt.parentCopy" "Parent's copy")}}</div>
  {{/if}}
</div>
{{> footer}}
