{{!-- Exam seating chart (A4, one page per room): the room drawn from the front, every seat with the student sitting
      there (roll no., name, class-section), the papers being written, the roll-number runs per class-section and the
      invigilators. exam.name · session {date, startTime, endTime} · status · classes[] {name, subject} ·
      rooms[] {name, code, students, invigilators[], columns, runs[] {section, from, to, count},
      rows[] {benches[] {seats[] {label, name, rollNo, section, tone, empty}}}} · compact.
      Data from services/examSeating.js (seatingChartPrint). --}}
<style>
  .room { break-after: page } .room:last-child { break-after: auto }
  .facts { margin-bottom: 3mm } .facts th { width: 26mm } .facts td { font-weight: 600 }
  .board { text-align: center; font-size: 7.5pt; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; border: .35mm solid #333; padding: .9mm; width: 60%; margin: 0 auto 3mm }
  .plan { display: flex; flex-direction: column; gap: 1mm }
  .row { display: grid; gap: 1.2mm }
  .bench { display: flex; gap: .5mm; min-width: 0; border: .25mm solid #555; padding: .5mm }
  .seat { flex: 1 1 0; min-width: 0; overflow: hidden; padding: .4mm .7mm; font-size: 6pt; line-height: 1.15; min-height: 6.4mm; border: .2mm solid #B8BCC4 }
  .seat .no, .seat .nm { white-space: nowrap; overflow: hidden; text-overflow: ellipsis } .seat .no { font-weight: 700; font-size: 6.8pt }
  .seat.empty { border-style: dashed; color: #A9AEB9 }
  .papers { font-size: 7.6pt; margin: 2mm 0 1.2mm } .papers b { font-weight: 700 }
  .runs { display: grid; grid-template-columns: repeat(4, 1fr); border-top: .25mm solid #555; border-left: .25mm solid #555; font-size: 7.8pt }
  .runs > div { border-right: .25mm solid #555; border-bottom: .25mm solid #555; padding: .4mm 1.5mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
  .runs b { display: inline-block; min-width: 9mm }
  .draft { font-weight: 700 }
  .signs { margin-top: 10mm } .facts th, .facts td { padding: .8mm 2mm }
</style>
{{#each rooms}}
<section class="room">
  {{#> letterhead}}{{/letterhead}}
  <div class="doc-title">{{t "exams.print.seating.title" "Seating plan"}}</div>
  <div class="doc-sub">{{../exam.name}}{{#if (eq ../status "DRAFT")}} · <span class="draft">{{t "exams.print.seating.draft" "Draft"}}</span>{{/if}}</div>
  <table class="grid facts">
    <tr><th>{{t "exams.print.door.room" "Room"}}</th><td>{{#if code}}{{code}}{{#if (ne code name)}} · {{name}}{{/if}}{{else}}{{name}}{{/if}}</td>
        <th>{{t "exams.print.seating.dateTime" "Date & time"}}</th><td>{{date ../session.date}} · {{../session.startTime}}{{#if ../session.endTime}}–{{../session.endTime}}{{/if}}</td></tr>
    <tr><th>{{t "exams.print.seating.students" "Students"}}</th><td>{{students}}</td>
        <th>{{t "exams.print.seating.invigilators" "Invigilators"}}</th><td>{{join invigilators ", "}}</td></tr>
  </table>
  <div class="board">{{t "exams.print.seating.front" "Front · board"}}</div>
  <div class="plan">
    {{#each rows}}
    <div class="row" style="grid-template-columns: repeat({{../columns}}, minmax(0, 1fr))">
      {{#each benches}}
      <div class="bench">
        {{#each seats}}
        {{#if empty}}<div class="seat empty"><div class="no">{{label}}</div></div>
        {{else if ../../../compact}}<div class="seat"><div class="no">{{label}}</div><div class="nm">{{section}}{{#if rollNo}}/{{rollNo}}{{/if}}</div></div>
        {{else}}<div class="seat"><div class="no">{{label}} · {{section}}{{#if rollNo}}/{{rollNo}}{{/if}}</div><div class="nm">{{name}}</div></div>{{/if}}
        {{/each}}
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>
  <div class="papers"><b>{{t "exams.print.seating.papers" "Papers"}}:</b> {{#each ../classes}}{{name}}{{#if subject}} — {{subject}}{{/if}}{{#unless @last}} · {{/unless}}{{/each}}</div>
  <div class="runs">{{#each runs}}<div><b>{{section}}</b> {{#if from}}{{t "exams.print.seating.rollRange" "Roll"}} {{from}}{{#if (ne from to)}}–{{to}}{{/if}}{{/if}} ({{count}})</div>{{/each}}</div>
  <div class="signs no-break"><div>{{t "exams.print.seating.invigilatorSign" "Invigilator(s)"}}</div><div>{{t "exams.print.seating.inchargeSign" "Controller / Exam in-charge"}}</div></div>
</section>
{{/each}}
