{{!-- Certificates (A4): bonafide, character, study, fee paid and merit. One layout; the wording follows the kind.
      An institution can rewrite any of it in Administration › Print templates. The QR opens the public
      verify page, so whoever receives the certificate can check it is genuine and not cancelled. --}}
<style>
  h1 { font-size: 15pt; text-align: center; letter-spacing: .12em; text-transform: uppercase; margin: 8mm 0 2mm }
  .no { display: flex; justify-content: space-between; font-size: 9pt; color: #5B616E; margin: 4mm 0 8mm }
  .body { font-size: 11.5pt; line-height: 1.85; text-align: justify; margin: 0 4mm }
  .body p { margin: 0 0 4mm }
  table.fees { width: 80%; margin: 2mm auto 5mm; border-collapse: collapse; font-size: 10.5pt }
  table.fees td { padding: 1.6mm 2mm; border-bottom: 1px solid #E3E5EA }
  table.fees td.n { text-align: right; white-space: nowrap }
  table.fees tr.tot td { font-weight: 700; border-top: 1px solid #8B90A0 }
  .merit { text-align: center; font-size: 12.5pt; line-height: 1.9; margin: 6mm 6mm }
  .merit .who { font-size: 19pt; font-weight: 700; margin: 3mm 0 }
  .merit .what { font-size: 13.5pt; font-weight: 600 }
  .foot { margin-top: 20mm; display: flex; justify-content: space-between; align-items: flex-end; gap: 8mm; font-size: 9.5pt }
  .sign { text-align: center; min-width: 55mm; border-top: 1px solid #8B90A0; padding-top: 2mm }
  .qr { text-align: center; font-size: 7.5pt; color: #5B616E }
  .void { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 56pt; font-weight: 800; color: rgba(214,69,69,.16); transform: rotate(-20deg); pointer-events: none }
</style>
{{#if certificate.cancelled}}<div class="void">{{t "certificates.print.stampCancelled" "CANCELLED"}}</div>{{/if}}
{{#> letterhead}}{{/letterhead}}
<h1>{{tc "certificates.print.title" certificate.kind certificate.kindLabel}}</h1>
<div class="no">
  <span>{{t "certificates.print.no" "Certificate No."}} <b class="mono">{{certificate.no}}</b></span>
  <span>{{t "certificates.print.date" "Date"}} <b>{{date certificate.issueDate}}</b></span>
</div>

{{#if certificate.merit}}
  <div class="merit">
    <div>{{t "certificates.print.merit.intro" "This certificate is proudly presented to"}}</div>
    <div class="who">{{student.name}}</div>
    <div>{{#if student.class}}{{t "certificates.print.merit.ofClass" "of {{cls}}" cls=student.class}}{{/if}}</div>
    <div>{{#if student.achievement}}{{t "certificates.print.merit.for" "for"}} <span class="what">{{student.achievement}}</span> {{t "certificates.print.merit.in" "in"}}{{else}}{{t "certificates.print.merit.participation" "for taking part in"}}{{/if}}</div>
    <div class="what">{{student.event}}</div>
    {{#if student.eventDate}}<div>{{t "certificates.print.merit.on" "held on {{date}}" date=(date student.eventDate)}}</div>{{/if}}
  </div>
{{else}}
<div class="body">
  {{#if certificate.bonafide}}
    <p>{{t "certificates.print.bonafide.text" "This is to certify that <b>{{name}}</b>{{parent}}, Admission No. {{admissionNo}}, is a bonafide student of this institution, studying in <b>{{cls}}</b> in the academic year {{year}}." name=student.name parent=student.parentPhrase admissionNo=student.admissionNo cls=student.class year=student.yearName}}</p>
    {{#if student.dob}}<p>{{t "certificates.print.dobLine" "{{his}} date of birth, as per our records, is {{dob}}." his=(tc "certificates.print.His" student.kid) dob=(date student.dob)}}</p>{{/if}}
  {{/if}}
  {{#if certificate.character}}
    <p>{{#if student.studying}}{{t "certificates.print.character.textIs" "This is to certify that <b>{{name}}</b>{{parent}}, Admission No. {{admissionNo}}, is a student of this institution since {{from}}." name=student.name parent=student.parentPhrase admissionNo=student.admissionNo from=(default (date student.from) "—")}}{{else}}{{t "certificates.print.character.textWas" "This is to certify that <b>{{name}}</b>{{parent}}, Admission No. {{admissionNo}}, was a student of this institution from {{from}} to {{to}}." name=student.name parent=student.parentPhrase admissionNo=student.admissionNo from=(default (date student.from) "—") to=(default (date student.to) "—")}}{{/if}}</p>
    <p>{{t "certificates.print.character.conduct" "To the best of our knowledge {{he}} bears a good moral character. {{his}} conduct has been <b>{{conduct}}</b>." he=(tc "certificates.print.he" student.kid) his=(tc "certificates.print.His" student.kid) conduct=student.conduct}}</p>
  {{/if}}
  {{#if certificate.study}}
    <p>{{#if student.studying}}{{t "certificates.print.study.textIs" "This is to certify that <b>{{name}}</b>{{parent}}, Admission No. {{admissionNo}}, has been studying in this institution since {{from}} (admitted to {{fromClass}}) and is now in <b>{{toClass}}</b>." name=student.name parent=student.parentPhrase admissionNo=student.admissionNo from=(default (date student.from) "—") fromClass=(default student.fromClass "—") toClass=(default student.toClass "—")}}{{else}}{{t "certificates.print.study.textWas" "This is to certify that <b>{{name}}</b>{{parent}}, Admission No. {{admissionNo}}, studied in this institution from <b>{{fromClass}}</b> ({{from}}) to <b>{{toClass}}</b> ({{to}})." name=student.name parent=student.parentPhrase admissionNo=student.admissionNo fromClass=(default student.fromClass "—") from=(default (date student.from) "—") toClass=(default student.toClass "—") to=(default (date student.to) "—")}}{{/if}}</p>
  {{/if}}
  {{#if certificate.fee}}
    <p>{{t "certificates.print.fee.text" "This is to certify that the following fees were paid to this institution for <b>{{name}}</b> ({{cls}}, Admission No. {{admissionNo}}) during the financial year <b>{{fy}}</b>:" name=student.name cls=(default student.class "—") admissionNo=student.admissionNo fy=fees.fy}}</p>
    <table class="fees">
      {{#each fees.heads}}<tr><td>{{name}}</td><td class="n">{{money amount}}</td></tr>{{/each}}
      {{#if fees.refunded}}<tr><td>{{t "certificates.print.fee.refunded" "Less: refunded"}}</td><td class="n">− {{money fees.refunded}}</td></tr>{{/if}}
      <tr class="tot"><td>{{t "certificates.print.fee.total" "Total paid"}}</td><td class="n">{{money fees.total}}</td></tr>
    </table>
    <p>{{t "certificates.print.fee.tuition" "Of this, the tuition fee is <b>{{amount}}</b> ({{words}})." amount=(money fees.tuition) words=(words fees.tuition)}}</p>
  {{/if}}
  {{#if certificate.purpose}}<p>{{t "certificates.print.purpose" "This certificate is issued on request for the purpose of {{purpose}}." purpose=certificate.purpose}}</p>{{/if}}
  {{#if certificate.remarks}}<p>{{certificate.remarks}}</p>{{/if}}
</div>
{{/if}}

<div class="foot">
  {{#if @root.$layout.showQr}}<div class="qr">{{qr verify.url 22}}<div>{{t "certificates.print.scan" "Scan to verify"}}</div><div class="mono">{{verify.code}}</div></div>{{else}}<div></div>{{/if}}
  {{#if certificate.merit}}<div class="sign">{{t "certificates.print.coordinator" "Teacher in charge"}}</div>{{/if}}
  <div class="sign">{{t "certificates.print.signature" "Principal"}}</div>
</div>
{{#if certificate.cancelled}}<p class="muted">{{t "certificates.print.cancelledNote" "Cancelled: {{reason}}" reason=certificate.cancelReason}}</p>{{/if}}
{{> footer}}
