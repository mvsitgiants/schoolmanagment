# Copy to backend/.env for local development. Every value has a safe dev default in src/config.js;
# production needs the ones marked REQUIRED.

NODE_ENV=development
PORT=4100
MONGO_URL=mongodb://127.0.0.1:27018/schoolgiant?replicaSet=rs0

# REQUIRED in production: long random values (32+ characters)
JWT_SECRET=dev-only-secret-change-me-before-production-000000
DATA_KEY=dev-only-data-key-change-me-before-production-00000

# Platform owner (Superadmin console) created by `npm run seed`
SUPERADMIN_EMAIL=owner@schoolgiant.test
SUPERADMIN_PASSWORD=Owner@123

# The web app's address (links in emails and messages) and allowed browser origins
APP_URL=http://localhost:5190
CORS_ORIGIN=http://localhost:5190

# Files: disk (default, backend/.data/uploads) or s3
STORAGE=disk
# S3_BUCKET=
# S3_REGION=ap-south-1

# HTML → PDF (docker compose service `gotenberg`); unset = prints stay HTML
# GOTENBERG_URL=http://127.0.0.1:3001

# Self sign-up on /signup (Superadmin › Settings can also switch it off)
SIGNUP_ENABLED=true
