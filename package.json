{
  "name": "schoolgiant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:db": "npm run db --workspace @schoolgiant/backend",
    "dev:api": "npm run dev --workspace @schoolgiant/backend",
    "dev:web": "npm run dev --workspace @schoolgiant/frontend",
    "start:api": "node scripts/dev.mjs api",
    "start:web": "node scripts/dev.mjs web",
    "seed": "npm run seed --workspace @schoolgiant/backend --",
    "seed:demo": "npm run seed:demo --workspace @schoolgiant/backend",
    "seed:demo:content": "npm run seed:demo:content --workspace @schoolgiant/backend",
    "test": "npm test --workspace @schoolgiant/backend --",
    "build": "npm run build --workspace @schoolgiant/frontend",
    "lint:pages": "npm run lint:pages --workspace @schoolgiant/frontend",
    "lint:i18n": "npm run lint:i18n --workspace @schoolgiant/frontend",
    "i18n:progress": "npm run i18n:progress --workspace @schoolgiant/frontend --"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "SchoolGiant — full-suite SaaS for schools, colleges and coaching institutes"
}
